{
  "name": "Annotator - Web & PDF Annotation",
  "short_name": "Annotator",
  "version": "{{ version }}",
  {{#browserIsChrome}}
  "version_name": "{{ version }} ({{ versionName }})",
  {{/browserIsChrome}}
  "manifest_version": 3,

  {{#browserIsChrome}}
  "minimum_chrome_version": "88",
  {{/browserIsChrome}}

  {{#key}}
  "key": "{{{ key }}}",
  {{/key}}

  {{#browserIsFirefox}}
  {{! Firefox's Manifest V3 needs an ID of the add-on's own, and Firefox 140 (ESR), the first with data_collection_permissions, or later. }}
  "browser_specific_settings": {
    "gecko": {
      "id": "annotator-extension@chaoticgood.computer",
      "strict_min_version": "140.0",
      {{! It sends annotations only to the service its settings name, on the user's machine for the *-local ones. }}
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  {{/browserIsFirefox}}

  "description": "Annotate, highlight, and tag web pages and PDFs with Hypothesis's client, keeping the annotations in your Obsidian vault.",
  "author": "Chaotic Good Computing, from the Hypothesis browser extension by the Hypothes.is Project",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },

  "homepage_url": "https://github.com/chaoticgoodcomputing/blog",

  {{! Firefox does not support the "split" mode.
      See https://developer.mozilla.org/en-US/Add-ons/WebExtensions/manifest.json/incognito
  }}
  {{#browserIsChrome}}
  "incognito": "split",
  {{/browserIsChrome}}

  "options_ui": {
    "page": "options/index.html"
  },

  {{#browserIsChrome}}
  "offline_enabled": false,
  {{/browserIsChrome}}

  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": ["<all_urls>"],

  "optional_permissions": [
    {{! Used to enumerate frames on certain websites. }}
    "webNavigation"
  ],

  {{! Firefox runs a background script as an event page, not as a service worker. }}
  "background": {
    {{#browserIsChrome}}
    "service_worker": "extension.bundle.js"
    {{/browserIsChrome}}
    {{#browserIsFirefox}}
    "scripts": ["extension.bundle.js"]
    {{/browserIsFirefox}}
  },

  "action": {
    "default_icon": {
      "19": "images/browser-icon-inactive.png",
      "38": "images/browser-icon-inactive@2x.png"
    }
  },

  {{#browserIsChrome}}
  "externally_connectable": {
    {{#bouncerUrl}}"matches": ["{{&bouncerUrl}}*"]{{/bouncerUrl}}
  },
  {{/browserIsChrome}}

  "web_accessible_resources": [
    {
      "resources": [
        "client/*",
        "help/*",
        "pdfjs/*",
        "pdfjs/web/viewer.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
