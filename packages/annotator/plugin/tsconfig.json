{
  "//": "Type-checking only: esbuild compiles (scripts/build.mjs). baseUrl is upstream's, whose sources import each other by bare name ('settings', 'utils').",
  "compilerOptions": {
    "baseUrl": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2021",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "jsx": "react",
    "allowJs": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
