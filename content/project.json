{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "vault",
  "root": "content",
  "projectType": "library",
  "implicitDependencies": [ "resume" ],
  "targets": {
    "precommit": {
      "//": "Runs all pre-commit tasks related to setting up the vault prior to builds and commits.",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run vault:sync",
          "nx run vault:index-tags"
        ],
        "cwd": "content",
        "parallel": false
      },
      "dependsOn": [
        "resume:publish",
        "vault:_clear-copilot"
      ]
    },
    "sync": {
      "//": "Run private scrub.mjs to populate private/dist, copy scrubbed content into public/, then normalize all internal links.",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node utils/extract-private-metadata.mjs",
          "node utils/fix-vault-links.mjs"
        ],
        "parallel": false,
        "cwd": "content"
      }
    },
    "index-tags": {
      "//": "Generate index.md files for all tags found in markdown frontmatter.",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node utils/generate-tag-indexes.mjs"
        ],
        "parallel": false,
        "cwd": "content"
      }
    },
    "download-annotation-pdfs": {
      "//": "Download PDFs referenced in annotation-target frontmatter to public/assets/annotated-documents/",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node utils/download-annotation-pdfs.mjs"
        ],
        "parallel": false,
        "cwd": "content"
      },
      "dependsOn": [ "vault:sync" ]
    },
    "list-non-private": {
      "//": "List all markdown files in content/public without 'private' tag or description field.",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node utils/list-non-private-files.mjs"
        ],
        "parallel": false,
        "cwd": "content"
      },
      "configurations": {
        "limit": {
          "commands": [
            "node utils/list-non-private-files.mjs -n 3"
          ]
        }
      }
    },
    "_clear-copilot": {
      "//": "Clean Obsidian Copilot conversations",
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "rm -rf .copilot/conversations/*"
        ],
        "parallel": false,
        "cwd": "content"
      }
    }
  }
}
