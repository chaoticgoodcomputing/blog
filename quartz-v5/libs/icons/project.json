{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@chaoticgoodcomputing/icons",
  "root": "quartz-v5/libs/icons",
  "sourceRoot": "quartz-v5/libs/icons/src",
  "projectType": "library",
  "tags": ["cgc", "cgc:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "{projectRoot}" }
    },
    "e2e": {
      "//": "Tested through its consumers' icon specs, cgc-tag-list's and cgc-graph's, in the shared suite. No build target: plugins inline the source.",
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test ../plugins/cgc-tag-list/e2e/icons.spec.mjs ../plugins/cgc-tag-list/e2e/site.spec.mjs ../plugins/cgc-graph/e2e/icons.spec.mjs",
        "cwd": "{workspaceRoot}/quartz-v5/tests"
      }
    }
  }
}
