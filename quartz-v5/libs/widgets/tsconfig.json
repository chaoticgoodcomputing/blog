{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    // Preact is a peer, never installed here: type-check against the host Quartz's copy, the one
    // quartz-mdx pins every widget to.
    "paths": {
      "preact": ["../../core/node_modules/preact"],
      "preact/*": ["../../core/node_modules/preact/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
