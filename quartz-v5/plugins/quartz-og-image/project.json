{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "quartz-og-image",
  "root": "quartz-v5/plugins/quartz-og-image",
  "sourceRoot": "quartz-v5/plugins/quartz-og-image/src",
  "projectType": "library",
  "tags": ["cgc", "cgc:plugin"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "node build.mjs", "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/build.mjs",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/src/**/*",
        "^production",
        "{workspaceRoot}/quartz-v5/core/pnpm-lock.yaml"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "e2e": {
      "//": "This package's specs only, through the shared suite.",
      "executor": "nx:run-commands",
      "options": { "command": "npx playwright test ../plugins/quartz-og-image", "cwd": "{workspaceRoot}/quartz-v5/tests" }
    }
  }
}
