{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "cgc-mdx",
  "root": "quartz-v5/plugins/cgc-mdx",
  "sourceRoot": "quartz-v5/plugins/cgc-mdx/src",
  "projectType": "library",
  "tags": ["cgc", "cgc:plugin"],
  "targets": {
    "install": {
      "//": "Isolated npm install. Peers are omitted on purpose: they resolve to the host Quartz's copies through quartz-v5/plugins/node_modules (see tests/harness/site.mjs).",
      "executor": "nx:run-commands",
      "options": { "command": "npm ci --omit=peer --no-audit --no-fund", "cwd": "{projectRoot}" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/dist"]
    },
    "e2e": {
      "//": "This package's specs only, through the shared suite.",
      "executor": "nx:run-commands",
      "options": { "command": "npx playwright test ../plugins/cgc-mdx", "cwd": "{workspaceRoot}/quartz-v5/tests" }
    }
  }
}
