{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "@chaoticgoodcomputing/icons",
  "root": "quartz/libs/icons",
  "sourceRoot": "quartz/libs/icons/src",
  "projectType": "library",
  "tags": ["cgc", "cgc:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run typecheck", "cwd": "{projectRoot}" }
    },
    "e2e": {
      "//": "Tested through its consumers' icon specs, quartz-tag-list's and quartz-graph's, in the shared suite. No build target: plugins inline the source.",
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test ../plugins/quartz-tag-list/e2e/icons.spec.mjs ../plugins/quartz-tag-list/e2e/site.spec.mjs ../plugins/quartz-graph/e2e/icons.spec.mjs",
        "cwd": "{workspaceRoot}/quartz/tests"
      }
    }
  }
}
