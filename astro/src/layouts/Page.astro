---
// The site shell: what is around a page's content, on every kind of page. Two columns: the graph
// column, and the note. The graph column holds the site's title, the search box with the colour
// scheme switch to the right of it, the local graph over the reader's trail, and the footer.
// Beside it are the trail's spines, the notes the reader came through, then the note itself: its
// header (title, date, tags) over the page's content, and what follows the body under it.
//
// The window is the one scroll: the graph column and the spines stay in view beside the note. On a
// phone or a tablet the graph column is a menu instead, opened from a bar over the note, which
// comes in from the left: a popover, so the browser closes it on Escape or a tap outside it, and a
// link followed from it loads a page with it closed. What a feature needs to know of the page it
// reads from `page`, and which kinds of page it is on is said where it is placed.
import { Icon } from "astro-icon/components"
import type { PageKind, PageProps } from "../lib/page.ts"
import { site } from "../site.config.ts"
import Base from "./Base.astro"

import SiteTitle from "../components/SiteTitle.astro"
import Search from "../components/Search.astro"
import SchemeSwitch from "../components/SchemeSwitch.astro"
import LocalGraph from "../components/LocalGraph.astro"
import SiteFooter from "../components/SiteFooter.astro"
import TrailSpines from "../components/TrailSpines.astro"

import ArticleTitle from "../components/ArticleTitle.astro"
import DateAndReadingTime from "../components/DateAndReadingTime.astro"
import TagList from "../components/TagList.astro"
import PostListing from "../components/PostListing.astro"
import PageLinks from "../components/PageLinks.astro"
import SourceLink from "../components/SourceLink.astro"

type Props = PageProps

const page = Astro.props
const on = (...kinds: PageKind[]) => kinds.includes(page.kind)

// Moving to another page, the note folds away to the left, into the spine it becomes, and the next
// slides in from the right; going back along the trail, the other way round. Which way a navigation
// goes is the trail's to say (TrailSpines.astro). The keyframes are the global style's below.
const timing = { duration: "0.4s", easing: "cubic-bezier(0.4, 0, 0.2, 1)", fillMode: "both" }
const fold = {
  forwards: {
    old: { name: "note-fold-away", ...timing },
    new: { name: "note-slide-in", ...timing },
  },
  backwards: {
    old: { name: "note-slide-away", ...timing },
    new: { name: "note-unfold", ...timing },
  },
}
---

<Base {...page}>
  <div class="page" data-kind={page.kind}>
    {/* A phone's or a tablet's: what opens the graph column. Not drawn on a desktop. */}
    <header class="menu-bar">
      <button type="button" popovertarget="graph-column" aria-label="Menu" title="Menu">
        <Icon name="mdi:menu" is:inline width="24" height="24" aria-hidden="true" />
      </button>
      <a class="menu-bar-title" href="/" data-trail-reset>{site.title}</a>
    </header>

    <aside
      class="graph-column"
      id="graph-column"
      popover
      transition:name="graph-column"
      transition:animate="none"
    >
      <header>
        <SiteTitle />
        <div class="toolbar">
          <Search />
          <SchemeSwitch />
        </div>
      </header>
      <LocalGraph url={page.url} />
      {/* The site's footer, though it is in the graph column: the page's contentinfo landmark. */}
      <footer role="contentinfo">
        <SiteFooter />
      </footer>
    </aside>

    <TrailSpines />

    <main transition:name="note" transition:animate={fold}>
      <header>
        {
          on("note", "home", "tag", "annotation") && (
            <ArticleTitle title={page.title} url={page.url} />
          )
        }
        {on("note", "home", "tag", "annotation") && <TagList tags={page.note?.tags ?? []} />}
        {on("note", "tag", "annotation") && <DateAndReadingTime note={page.note} />}
      </header>

      <slot />

      <div class="after-body">
        {/* On a tag page, the posts under `page.tag`. */}
        {on("home", "tag", "404") && <PostListing tag={page.tag} />}
        {on("note", "tag", "annotation") && <PageLinks note={page.note} />}
        {on("note") && <SourceLink note={page.note} />}
      </div>
    </main>
  </div>
</Base>

<style>
  /* The graph column, the spines (as wide as the trail before the note, and none without one), and
     the note. Each in its own named area, so the note keeps its column when the spines are hidden. */
  .page {
    display: grid;
    grid-template-columns: 22rem auto minmax(0, 1fr);
    grid-template-areas: "graph spines note";
    min-height: 100vh;
  }

  .page > :global(trail-spines) {
    grid-area: spines;
  }

  main {
    grid-area: note;
  }

  .menu-bar {
    display: none;
  }

  /* The graph column: a header, the graph filling the room between, and a footer. As tall as the
     window, and in view while the note scrolls. It is a popover, which the browser hides until it is
     opened, and draws in a box of its own: on a desktop it is always drawn, as the page's column. */
  .graph-column {
    grid-area: graph;
    position: sticky;
    inset: 0 auto auto;
    align-self: start;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    box-sizing: border-box;
    width: auto;
    height: 100vh;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: none;
    border-right: 1px solid var(--lightgray);
    color: inherit;
    background: var(--light);
  }

  .graph-column > header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.25rem 1.25rem;
    border-bottom: 1px solid var(--lightgray);
  }

  /* The search box, and the scheme switch to the right of it. */
  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 18.5rem;
  }

  .graph-column > header :global(.search-button) {
    width: 100%;
  }

  .graph-column > footer {
    padding: 1rem 1.25rem 1.25rem;
    border-top: 1px solid var(--lightgray);
  }

  /* The note: its text as wide as reads well, 40rem, in the middle of the room it has. The note
     itself fills that room, the same box on every page, so its fold from one page to the next is
     one box's (the global style below). A wide table or a long line of code scrolls inside it, and
     the page stays as wide as the window. */
  main {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 2.5rem max(2rem, calc((100% - 40rem) / 2)) 6rem;
  }

  /* The page's header, its title, date and tags, centred, as every heading is (global.css). */
  main > header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  main > header > :global(*) {
    max-width: 100%;
  }

  main > header :global(.tag-list) {
    justify-content: center;
  }

  .after-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--lightgray);
  }

  /* A place with no feature in it on this kind of page takes no room, and draws no rule. */
  main > header:not(:has(*)),
  .after-body:not(:has(*)) {
    display: none;
  }

  /* A section after the body is headed by an `h2`, which the shell spaces, so that every feature's
     heading is alike: as much room under it as under a heading in a note (note-body.css). Written
     with no specificity: a feature's own styles say otherwise by saying so. */
  .after-body :global(:where(h2)) {
    margin: 0 0 1.5rem;
  }

  /* An annotation page whose document opens takes the whole of the note's room: the annotation
     viewer lays itself out by the room it has, the document beside its cards where they fit. One
     whose document couldn't be shown is laid out as any note. */
  .page:has(.annotation-viewer:not([data-state="failed"])) main {
    padding-inline: 1.5rem;
  }

  /* A phone or a tablet: one column. A bar over the note opens the graph column, which comes in from
     the left, over the page, as tall as the screen; the spines are a row under the bar. */
  @media (width < 1000px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
      /* A short note's page is still a screen tall: the room it doesn't fill is the note's. */
      grid-template-rows: auto auto 1fr;
      grid-template-areas: "bar" "spines" "note";
    }

    .menu-bar {
      grid-area: bar;
      position: sticky;
      top: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--lightgray);
      background: var(--light);
    }

    .menu-bar button {
      display: grid;
      place-items: center;
      padding: 0.25rem;
      border: none;
      border-radius: 4px;
      background: none;
      color: var(--dark);
      cursor: pointer;
    }

    .menu-bar button:hover {
      background: var(--highlight);
    }

    .menu-bar-title {
      font-weight: 700;
      color: var(--dark);
      text-decoration: none;
    }

    .graph-column {
      position: fixed;
      inset: 0 auto 0 0;
      width: min(22rem, 85vw);
      height: 100dvh;
      box-shadow: 0 0 2rem var(--shadow);
      transform: translateX(-100%);
      transition:
        transform 0.2s ease-out,
        display 0.2s allow-discrete,
        overlay 0.2s allow-discrete;
    }

    .graph-column:not(:popover-open) {
      display: none;
    }

    .graph-column:popover-open {
      transform: none;
    }

    @starting-style {
      .graph-column:popover-open {
        transform: translateX(-100%);
      }
    }

    .graph-column::backdrop {
      background: var(--scrim);
    }

    main {
      padding: 1.5rem 1rem 4rem;
    }
  }

  @media (width < 1000px) and (prefers-reduced-motion: reduce) {
    .graph-column {
      transition: none;
    }
  }
</style>

<style is:global>
  /* The note's fold (`fold` above): into its left edge, where the spines are, and out of it. Flat,
     not turned in depth: a note is a box as tall as the whole note, whose middle may be far below
     the window, and turned about it the part in view would slant. */
  ::view-transition-old(note),
  ::view-transition-new(note) {
    transform-origin: left center;
  }

  @keyframes note-fold-away {
    to {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes note-unfold {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes note-slide-in {
    from {
      transform: translateX(6rem);
      opacity: 0;
    }
  }

  @keyframes note-slide-away {
    to {
      transform: translateX(6rem);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(note),
    ::view-transition-new(note) {
      animation: none;
    }
  }
</style>
