---
// The site shell: what is around a page's content, on every kind of page. Two columns: the graph
// column, and the note. The graph column holds the site's title and the search box, the local
// graph over the reader's trail, and the footer. Beside it are the trail's spines, the notes the
// reader came through, then the note itself: its header (title, date, tags) over the page's
// content, and what follows the body under it.
//
// The window is the one scroll: the graph column and the spines stay in view beside the note. What
// a feature needs to know of the page it reads from `page`, and which kinds of page it is on is
// said where it is placed.
import type { PageKind, PageProps } from "../lib/page.ts"
import Base from "./Base.astro"

import SiteTitle from "../components/SiteTitle.astro"
import Search from "../components/Search.astro"
import LocalGraph from "../components/LocalGraph.astro"
import SiteFooter from "../components/SiteFooter.astro"
import TrailSpines from "../components/TrailSpines.astro"

import ArticleTitle from "../components/ArticleTitle.astro"
import DateAndReadingTime from "../components/DateAndReadingTime.astro"
import TagList from "../components/TagList.astro"
import PostListing from "../components/PostListing.astro"
import Backlinks from "../components/Backlinks.astro"
import SourceLink from "../components/SourceLink.astro"

type Props = PageProps

const page = Astro.props
const on = (...kinds: PageKind[]) => kinds.includes(page.kind)
---

<Base {...page}>
  <div class="page">
    <aside class="graph-column">
      <header>
        <SiteTitle />
        <Search />
      </header>
      <LocalGraph url={page.url} />
      <footer>
        <SiteFooter />
      </footer>
    </aside>

    <TrailSpines />

    <main>
      <header>
        {on("note", "home", "tag", "annotation") && <ArticleTitle title={page.title} url={page.url} />}
        {on("note", "tag", "annotation") && <DateAndReadingTime note={page.note} />}
        {on("note", "home", "tag", "annotation") && <TagList tags={page.note?.tags ?? []} />}
      </header>

      <slot />

      <div class="after-body">
        {/* On a tag page, the posts under `page.tag`. */}
        {on("home", "tag", "404") && <PostListing tag={page.tag} />}
        {on("note", "tag", "annotation") && <Backlinks note={page.note} />}
        {on("note") && <SourceLink note={page.note} />}
      </div>
    </main>
  </div>
</Base>

<style>
  /* The graph column, the spines (as wide as the trail before the note), and the note. */
  .page {
    display: grid;
    grid-template-columns: 22rem auto minmax(0, 1fr);
    min-height: 100vh;
  }

  /* The graph column: a header, the graph filling the room between, and a footer. As tall as the
     window, and in view while the note scrolls. */
  .graph-column {
    position: sticky;
    top: 0;
    align-self: start;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    box-sizing: border-box;
    height: 100vh;
    border-right: 1px solid var(--lightgray);
  }

  .graph-column > header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.25rem 1.25rem;
    border-bottom: 1px solid var(--lightgray);
  }

  .graph-column > header > :global(site-search) {
    width: 100%;
    max-width: 16rem;
  }

  .graph-column > header :global(.search-button) {
    width: 100%;
  }

  .graph-column > footer {
    padding: 1rem 1.25rem 1.25rem;
    border-top: 1px solid var(--lightgray);
  }

  /* The note: as wide as reads well, in the middle of the room it has. A wide table or a long line
     of code scrolls inside it, and the page stays as wide as the window. */
  main {
    box-sizing: border-box;
    width: 100%;
    max-width: 44rem;
    min-width: 0;
    margin: 0 auto;
    padding: 2.5rem 2rem 6rem;
  }

  main > header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .after-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--lightgray);
  }

  /* A place with no feature in it on this kind of page takes no room, and draws no rule. */
  main > header:not(:has(*)),
  .after-body:not(:has(*)) {
    display: none;
  }

  /* A section after the body is headed by an `h2`, which the shell sizes, so that every feature's
     heading is alike. Written with no specificity: a feature's own styles say otherwise by saying so. */
  .after-body :global(:where(h2)) {
    margin: 0 0 0.25rem;
    font-size: 1rem;
  }

  /* An annotation page whose document opens takes the whole of the note's room: the annotation
     viewer lays itself out by the room it has, the document beside its cards where they fit. One
     whose document couldn't be shown is laid out as any note. */
  .page:has(.annotation-viewer:not([data-state="failed"])) main {
    max-width: none;
    padding-inline: 1.5rem;
  }

  /* A phone or a tablet: one column. The graph column over the note, as tall as its graph needs,
     and the spines a row between them. */
  @media (width < 1000px) {
    .page {
      grid-template-columns: minmax(0, 1fr);
    }

    .graph-column {
      position: static;
      grid-template-rows: auto 40vh auto;
      height: auto;
      border-right: none;
      border-bottom: 1px solid var(--lightgray);
    }

    main {
      padding: 1.5rem 1rem 4rem;
    }
  }
</style>
