---
// The page's colour scheme is the reader's system's (src/styles/global.css), so whatever CSS
// paints follows it by itself. What paints in script reads its colours once (a graph's canvas, a
// diagram), so a change of the system's scheme is announced to it: `themechange` on `document`,
// its `detail.theme` the scheme now in use.
//
// A bundled script runs once per document, however many pages the client router brings in.
---

<script>
  const system = matchMedia("(prefers-color-scheme: dark)")
  system.addEventListener("change", () => {
    document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: system.matches ? "dark" : "light" } }))
  })
</script>
