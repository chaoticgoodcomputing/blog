---
// What the graph column ends with: the site's notice, how to reach its author, and its copyright.
// Every value is site configuration's `footer`.
import { footer } from "../site.config.ts"

// The year the site was last built, which a deploy keeps current.
const year = new Date().getFullYear()
---

<div class="site-footer">
  <a href="https://blog.chaoticgood.computer/ai-policy" class="notice">{footer.notice}</a>
  <ul>
    {
      footer.contacts.map((link) => (
        <li>
          <a href={link.url}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <p>
    Copyright{" "}
    {
      footer.copyright.map((holder, index) => (
        <Fragment>
          {index > 0 && " & "}
          <a href={holder.url}>{holder.label}</a>
        </Fragment>
      ))
    }{" "}
    © {year}
  </p>
</div>

<style>
  .site-footer {
    font-size: 0.8rem;
    text-align: center;
    color: var(--darkgray);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  p {
    margin: 0.4rem 0 0;
  }

  .notice {
    margin: 0;
    color: var(--gray);
  }

  /* Bold, and with no underline: a row of nothing but links. */
  a {
    font-weight: 600;
    text-decoration: none;
  }
</style>
