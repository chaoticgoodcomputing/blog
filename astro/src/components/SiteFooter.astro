---
// What the graph column ends with: the site's notice, how to reach its author, and its copyright.
// Every value is site configuration's `footer`.
import { newTab } from "../lib/external-links.ts"
import { footer } from "../site.config.ts"
import type { SiteLink } from "../site.config.types.ts"

// A contact's new tab, if it is on another site, and `rel="me"` if it is the author's own profile.
const withMe = (link: SiteLink) => {
  const { rel, ...tab } = newTab(link.url, Astro.site!)
  const rels = [rel, link.me && "me"].filter(Boolean).join(" ")
  return rels ? { ...tab, rel: rels } : tab
}

// The year the site was last built, which a deploy keeps current.
const year = new Date().getFullYear()
---

<div class="site-footer">
  <a href="https://blog.chaoticgood.computer/ai-policy" class="notice">{footer.notice}</a>
  <ul>
    {
      footer.contacts.map((link) => (
        <li>
          <a href={link.url} {...withMe(link)}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p>
    Copyright{" "}
    {
      footer.copyright.map((holder, index) => (
        <Fragment>
          {index > 0 && " & "}
          <a href={holder.url} {...newTab(holder.url, Astro.site!)}>
            {holder.label}
          </a>
        </Fragment>
      ))
    }{" "}
    © {year}
  </p>
</div>

<style>
  .site-footer {
    font-size: 0.8rem;
    text-align: center;
    color: var(--darkgray);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  p {
    margin: 0.4rem 0 0;
  }

  .notice {
    margin: 0;
    color: var(--gray);
  }

  /* Bold, and with no underline: a row of nothing but links. */
  a {
    font-weight: 600;
    text-decoration: none;
  }
</style>
