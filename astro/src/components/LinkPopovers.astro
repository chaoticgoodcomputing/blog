---
// Link popovers: while the pointer rests on a link to another page of the site, in a note or in
// what lists pages around it, a preview of that page's note beside the link, without leaving the
// page. The preview is the page as the site serves it, fetched, and its title and rendered body
// (`.prose`) taken out of it. The title heads the preview, set apart over the body, and stays there
// while the body scrolls under it.
//
// It is at the end of the body of every page, and is one element, `<link-popovers>`, which listens
// for the pointer over the whole page while it is there (README.md, "In the browser"). The preview
// is a popover in the top layer, over the sidebars. It opens without moving focus, and never holds
// it: it closes when the pointer leaves both it and its link, or on Escape, as every hover popover
// does (src/lib/hover-popover.ts). A click on it opens the page, as a click on its link would; a
// click on a link in it follows that link instead.
//
// What the body holds is shown as the page's HTML has it. Its scripts never run, and an element
// that draws itself, a mermaid diagram, draws itself only where this page has its code: on a page
// with no diagram of its own, a preview shows a diagram's source, and no mermaid is loaded for it.
---

<link-popovers class="link-popovers">
  <div class="link-popover" popover="manual">
    <div class="link-popover-title"></div>
    <div class="link-popover-body"></div>
  </div>
</link-popovers>

<script>
  import { HoverPopover } from "../lib/hover-popover.ts"

  /** What a preview shows of a page: its title, if it has one, its rendered body, and the stylesheets the page links. */
  interface Preview {
    title: HTMLElement | null
    body: HTMLElement
    stylesheets: HTMLLinkElement[]
  }

  // The pages already fetched, by address, each as its preview, or none.
  const previews = new Map<string, Promise<Preview | undefined>>()

  // What a body shows besides its text.
  const MEDIA = "img, svg, picture, video, audio, iframe, canvas, object, embed, math"

  /**
   * The preview of the page at an address, or none when it is no page with a body, or its body
   * shows nothing, as an empty note's does.
   */
  function previewOf(address: string): Promise<Preview | undefined> {
    let preview = previews.get(address)
    if (!preview) {
      preview = fetch(address)
        .then(async (response) => {
          if (!response.ok || !response.headers.get("Content-Type")?.startsWith("text/html")) return undefined
          const page = new DOMParser().parseFromString(await response.text(), "text/html")
          const body = page.querySelector<HTMLElement>(".prose")
          if (!body || (!body.textContent?.trim() && !body.querySelector(MEDIA))) return undefined
          const title = page.querySelector<HTMLElement>("main > header .article-title")
          return { title, body, stylesheets: [...page.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')] }
        })
        .catch(() => undefined)
      previews.set(address, preview)
    }
    return preview
  }

  /**
   * The stylesheets a page links that this one doesn't. A stylesheet only some pages need, as
   * KaTeX's is, is linked by the page that needs it, and not by this one.
   */
  function missing(stylesheets: HTMLLinkElement[]): HTMLLinkElement[] {
    const linked = new Set(
      [...document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].map((link) => link.href),
    )
    return stylesheets.filter((stylesheet) => !linked.has(stylesheet.href))
  }

  // Where a link has a preview: a note's body, and what lists or names other pages around it.
  const PREVIEWED = ".prose, .backlinks, .post-listing, .tag-badge"

  /**
   * The page a link on this page goes to on this site, if a preview can be shown of it: a link in
   * a note, or in the backlinks, a post listing, the tag explorer or a tag badge (`PREVIEWED`). A
   * link anywhere else has none: the site's title, a table of contents, a search result, whose
   * preview would cover the results under it, or a link in a preview. An unresolved link goes
   * nowhere, and a link to an attachment is to a file that is no page, which is left to the browser:
   * neither is fetched. Markdown's links to an attachment carry
   * `data-astro-reload`; a widget's own do not, and are known by their address: a page's has no
   * extension, and a file's does. So a note named with a dot in its last part,
   * `v1.2`, would have no preview, and no note of the vault is. Outside the note, a link to the
   * page the reader is on has none: the reader is there. In the note, a link to a place on it has
   * one, to read it without leaving the place, but a heading's link to itself has none: it is on the
   * heading it would show. Nor does a footnote's reference: its sidenote is beside or under it
   * (src/lib/sidenotes.ts).
   */
  function previewed(link: HTMLAnchorElement): URL | undefined {
    if (!link.closest(PREVIEWED) || link.closest(".link-popover")) return undefined
    if (link.matches(".heading-anchor, .annotation-anchor") || link.hasAttribute("data-footnote-ref")) return undefined
    if (link.classList.contains("is-unresolved") || link.hasAttribute("data-astro-reload")) return undefined
    const url = new URL(link.href)
    if (url.origin !== location.origin || /\.[^./]+$/.test(url.pathname)) return undefined
    if (url.pathname === location.pathname && !link.closest(".prose")) return undefined
    return url
  }

  class LinkPopovers extends HTMLElement {
    #popover!: HTMLElement
    #title!: HTMLElement
    #body!: HTMLElement
    #hover!: HoverPopover<HTMLAnchorElement>
    #disconnect: (() => void) | undefined
    /** What the open preview's link names on its page, which goes to the top of the body. */
    #named: HTMLElement | null = null

    // A click on the preview is a click on its link, so that the page is reached as the link reaches
    // it: by the client router, along the trail (TrailNavigation.astro). One with a modifier key, or the
    // middle button, opens it in a new tab. What has a click of its own keeps it: a link in the
    // preview, a form's control, a summary. A click that ends a drag across the text, to select it,
    // opens nothing.
    #click = (event: MouseEvent) => {
      const link = this.#hover.wanted?.key
      if (!link || (event.button !== 0 && event.button !== 1)) return
      if ((event.target as Element).closest("a[href], button, input, select, textarea, label, summary")) return
      if (!(getSelection()?.isCollapsed ?? true)) return
      event.preventDefault()
      this.#hover.close()
      if (event.button === 1 || event.ctrlKey || event.metaKey || event.shiftKey) {
        window.open(link.href, "_blank", "noopener")
      } else {
        link.click()
      }
    }

    connectedCallback() {
      this.#popover = this.querySelector(".link-popover")!
      this.#title = this.querySelector(".link-popover-title")!
      this.#body = this.querySelector(".link-popover-body")!
      this.#popover.addEventListener("click", this.#click)
      this.#popover.addEventListener("auxclick", this.#click)
      this.#hover = new HoverPopover({
        popover: this.#popover,
        find: (target) => {
          const link = target.closest?.<HTMLAnchorElement>("a[href]")
          return link && previewed(link) ? { anchor: link, key: link } : undefined
        },
        fill: (link) => this.#fill(link),
        // The heading or block the link names is at the top of the body, a little below the title.
        opened: () => {
          const preview = this.#body.lastElementChild!
          this.#body.scrollTop = this.#named
            ? this.#named.getBoundingClientRect().top - preview.getBoundingClientRect().top - 12
            : 0
        },
      })
      this.#disconnect = this.#hover.connect()
    }

    disconnectedCallback() {
      this.#disconnect?.()
    }

    async #fill(link: HTMLAnchorElement): Promise<boolean> {
      const url = previewed(link)!
      const fetched = await previewOf(url.pathname)
      if (!fetched || this.#hover.wanted?.key !== link) return false
      const preview = fetched.body.cloneNode(true) as HTMLElement
      const id = decodeURIComponent(url.hash.slice(1))
      this.#named = id ? preview.querySelector<HTMLElement>(`[id="${CSS.escape(id)}"]`) : null
      // The page already has the ids it needs: one in a preview would be a second, where a link to
      // a heading on this page might land.
      for (const element of preview.querySelectorAll("[id]")) element.removeAttribute("id")
      // A heading's or an annotation's link to itself would go to a place on this page.
      for (const anchor of preview.querySelectorAll(".heading-anchor, .annotation-anchor")) anchor.remove()
      // So would a sidenote's number, its link back to its reference: it is left a number, and a
      // click on it opens the page, as a click on the preview's text does.
      for (const number of preview.querySelectorAll(".sidenote-number")) number.removeAttribute("href")

      // The title, without the h-entry's name it is on its own page (EntryMeta.astro).
      const title = fetched.title?.cloneNode(true) as HTMLElement | undefined
      title?.classList.remove("p-name")
      this.#title.replaceChildren(...(title ? [title] : []))
      this.#body.replaceChildren(...missing(fetched.stylesheets).map((link) => link.cloneNode()), preview)
      return true
    }
  }

  customElements.define("link-popovers", LinkPopovers)
</script>

<style>
  .link-popover {
    /* Where the script puts it, not where a popover is put by default, in the middle of the window. */
    inset: auto;
    margin: 0;
    box-sizing: border-box;
    width: min(30rem, 100vw - 1rem);
    max-height: 20rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--lightgray);
    border-radius: 5px;
    background-color: var(--light);
    color: var(--darkgray);
    box-shadow: 0 1rem 3rem var(--shadow);
    /* The whole of it is a link to its page. */
    cursor: pointer;
    /* A preview is the note in small: the whole reading scale (global.css) at this size. */
    --noteFontSize: 0.9rem;
    font-size: var(--text-body);
  }

  /* The title over the body, and the body, the one that scrolls, under it. Only while open: a
     popover's own `display: none` is what hides it otherwise. */
  .link-popover:popover-open {
    display: flex;
    flex-direction: column;
  }

  /* The title, set apart from the body by a rule. Its size is an h1's, at the preview's scale
     (global.css), so smaller than on its page. */
  .link-popover-title {
    flex: none;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--lightgray);
  }

  .link-popover-title:empty {
    display: none;
  }

  .link-popover-title > :global(h1) {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .link-popover-body {
    min-height: 0;
    padding: 1rem;
    overflow: auto;
    overscroll-behavior: contain;
  }
</style>
