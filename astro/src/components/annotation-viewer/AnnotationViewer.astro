---
// The annotation viewer: an annotation page's annotated document, drawn from the site's mirror of
// it, with each annotation's passage highlighted, and the page's annotations, its cards, in a drawer
// beside it and in popovers over its highlights.
//
// The page's body is this component's slot: the preface, the source of the document, the
// annotations and the epilogue, which the Markdown pipeline makes. As built, and for good
// where the document can't be shown, the cards are the page, in one column (`data-layout="static"`).
// Once the document opens, it takes the whole of the viewer's width, on a desktop as on a phone, and
// the cards are read two ways:
// - **the popover**: where the pointer can rest on a highlight, as a mouse's can, its annotation's
//   card opens beside it, as a link's preview does (src/lib/hover-popover.ts), with any replies to
//   it. A click on the popover is a click on the highlight.
// - **the drawer**: the cards come in from the right, in order, with those whose passage isn't in
//   the document last, under "Not found in the document". On a desktop or a tablet the drawer is a
//   card's width and the document stays usable beside it; on a phone, where that would cover more
//   than half the screen, it is most of the screen, and modal. It opens from its tab on the right
//   edge, tapped or dragged, or from a clicked highlight, at its card. It always starts closed.
// The page is the one scroll: the document is never a box that scrolls by itself, and pans
// sideways in its column only when it is zoomed wider than it. Where the page has a preface, a link
// over it goes past it, to the document, and gives it the focus.
//
// Over the document is its bar, which stays at the top of the window, under a phone's menu bar,
// while the document is read: the document's title, its file's name without its extension; where it
// was retrieved from, a link to it at its address, in place of the body's line saying where it comes
// from; and the zoom's buttons.
//
// Selecting an annotation marks its card and its highlights, and writes its address, `#^id`, in
// place of the page's (history.replaceState), so the back button isn't cluttered. A card, a
// highlight, `j` and `k` select; `Esc` clears; a page opened at an annotation's address opens with
// it selected. Zoom is the viewer's, not the browser's: `+`, `-` and `0`, or a pinch of the
// document, or the document's bar; 100% is the fitted width, which every page opens at. None of
// the keys act while the reader is typing, or a dialog is open.
//
// PDF.js is loaded by the element's script as the page loads (./document.ts), so a page of another
// kind has none of it. A mirror the browser can't open or draw leaves the page laid out as any
// note's (`data-state="failed"`), with "(PDF not available)" after the link to the annotated
// document itself, and the link over the preface going to the annotations instead.
//
// What the script sets on the body's annotations, and how they are laid out in the drawer, is
// styled in src/styles/prose/annotation-viewer.css: scoped styles never reach a slot.
import { Icon } from "astro-icon/components"
import { CARD_WIDTH } from "../../lib/annotation-layout.ts"
import { annotatedPassages, annotationDate, annotationPropertiesOf, documentFileName } from "../../lib/annotations.ts"
import type { Note } from "../../lib/notes.ts"
import { getVault } from "../../lib/vault.ts"

interface Props {
  note: Note
  /** The mirror's address, from the site's root and not encoded: `mirrorFor(note)`. */
  mirror: string
  /** Its text file's address, for a scanned mirror: `mirrorTextFor(note)`. */
  text?: string | undefined
}

const { note, mirror, text } = Astro.props
const properties = annotationPropertiesOf(note)!
const target = properties.target
const name = documentFileName(target) ?? target
// A note with a page range is shown its mirror's slice of those pages (src/lib/mirrors.ts), where a
// passage's place, counted in characters from the start of the whole document, is no guide: it is
// found by its quote alone.
const sliced = properties.pages !== undefined
const passages = annotatedPassages(note, getVault()).map(({ start, ...passage }) => (sliced ? passage : { ...passage, start }))
// The document's id, which the link over the preface goes to.
const DOCUMENT = "annotated-document"
// What the bar says of the document. A mirror is only ever of a document on the web, so its target
// is an address. It was retrieved for the build that made this page, whose date it is: the page is
// drawn again by every build, where the note's body is kept while its source is unchanged.
const title = name.replace(/\.pdf$/i, "")
const source = URL.canParse(target) ? new URL(target) : undefined
const retrieved = new Date()
---

<annotation-viewer
  class="annotation-viewer"
  data-layout="static"
  data-src={encodeURI(mirror)}
  data-text={text && encodeURI(text)}
  data-passages={JSON.stringify(passages)}
  data-card-width={CARD_WIDTH}
  style={`--card-width: ${CARD_WIDTH}`}
>
  <a class="to-document" href={`#${DOCUMENT}`}>
    <Icon name="mdi:arrow-down" is:inline width="16" height="16" fill="currentColor" aria-hidden="true" />
    <span class="label">Go to the annotated document</span>
  </a>
  <div class="layout">
    <div class="frame" data-pagefind-ignore>
      <div class="bar">
        <div class="about">
          <p class="title" title={title}>{title}</p>
          {
            source && (
              <p class="retrieved">
                Retrieved from <a href={encodeURI(decodeURI(target))}>{source.host}</a> on{" "}
                <time datetime={retrieved.toISOString().slice(0, 10)}>{annotationDate(retrieved)}</time>
              </p>
            )
          }
        </div>
        <div class="zoom" role="group" aria-label="Zoom">
          <button type="button" data-zoom="out" aria-label="Zoom out" title="Zoom out (-)">
            <Icon name="mdi:minus" is:inline width="18" height="18" fill="currentColor" aria-hidden="true" />
          </button>
          <button type="button" data-zoom="reset" aria-label="Reset the zoom" title="Reset the zoom (0)">
            <span class="level">100%</span>
          </button>
          <button type="button" data-zoom="in" aria-label="Zoom in" title="Zoom in (+)">
            <Icon name="mdi:plus" is:inline width="18" height="18" fill="currentColor" aria-hidden="true" />
          </button>
        </div>
      </div>
      <div class="document" id={DOCUMENT} tabindex="-1" role="region" aria-label={`The annotated document, ${name}`}>
        <p class="status" data-loading>Loading the document…</p>
        <div class="pages"></div>
      </div>
    </div>
    <slot />
  </div>
  <button class="tab" type="button" aria-label="Annotations" aria-expanded="false" tabindex="-1">
    <span class="grip" aria-hidden="true"></span>
  </button>
  <div class="scrim" aria-hidden="true"></div>
  {/* A highlight's annotation, while the pointer rests on the highlight. In `.prose`, as the cards
      are, so it is styled as they are (src/styles/prose/annotations.css). */}
  <div class="annotation-popover prose" popover="manual" data-pagefind-ignore></div>
</annotation-viewer>

<script>
  import { clampZoom, fit, steppedZoom, toPx, ZOOMS, type Fit, type Layout } from "../../lib/annotation-layout.ts"
  import type { AnnotatedPassage } from "../../lib/highlights.ts"
  import { HoverPopover } from "../../lib/hover-popover.ts"
  import type { Place, Shown } from "./document.ts"

  /** How far a drag or a swipe must go to open or close the drawer, in pixels. */
  const SWIPE = 40
  /** How far below the top of the window, or of a phone's menu bar, a passage gone to sits, in pixels. */
  const BELOW_BAR = 32
  /** The id the script gives the page's section of annotations, which the tab controls. */
  const CARDS = "annotation-cards"

  // An annotation's block id from an address's fragment, `#^id`, without its `^`.
  const idIn = (hash: string): string | undefined => /^#\^(.+)$/.exec(decodeURIComponent(hash))?.[1]
  const idOf = (card: Element): string => card.id.replace(/^\^/, "")

  // Whether a key press is the reader typing, or meant for something else: a field, a shortcut, or
  // a dialog in front of the page (search, the global graph). A hover popover is none: it is
  // only read, and the keys go on acting under it.
  const typing = (event: KeyboardEvent): boolean => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return true
    const target = event.target as HTMLElement | null
    if (target?.closest?.("input, textarea, select, [contenteditable]:not([contenteditable='false'])")) return true
    return !!document.querySelector("dialog[open], :popover-open:not(.annotation-popover, .link-popover)")
  }

  class AnnotationViewer extends HTMLElement {
    #shown: Shown | undefined
    #places = new Map<string, Place>()
    #layout: Layout = "static"
    #fit: Fit | undefined
    #selected: string | undefined
    #pending: string | undefined
    #drawerOpen = false
    #returnFocus: HTMLElement | null = null
    #zoom = 1
    #dragged = false
    #queued = 0
    #cleanups: (() => void)[] = []
    #disconnected = false
    #popover: HoverPopover<string> | undefined

    #on(target: EventTarget, type: string, listener: (event: any) => void, options?: AddEventListenerOptions) {
      target.addEventListener(type, listener, options)
      this.#cleanups.push(() => target.removeEventListener(type, listener, options))
    }

    get #section() {
      return this.querySelector<HTMLElement>("section.annotations")
    }
    get #pages() {
      return this.querySelector<HTMLElement>(".pages")!
    }
    // What covers the top of the window: a phone's or a tablet's menu bar (src/layouts/Page.astro).
    get #covered() {
      return document.querySelector<HTMLElement>(".menu-bar")?.offsetHeight ?? 0
    }
    // What covers the top of the window over the document: that, and the document's bar under it.
    get #coveredOverDocument() {
      return this.#covered + (this.querySelector<HTMLElement>(".bar")?.offsetHeight ?? 0)
    }
    #cards() {
      return [...this.querySelectorAll<HTMLElement>("section.annotations > .annotation")]
    }
    #card(id: string) {
      return this.#cards().find((card) => idOf(card) === id)
    }

    connectedCallback() {
      this.#disconnected = false
      this.#zoom = 1
      const section = this.#section
      if (section) {
        section.id = CARDS
        section.tabIndex = -1
      }
      this.querySelector(".tab")!.setAttribute("aria-controls", CARDS)

      // A highlight's annotation, in a popover beside it, while the pointer rests on it.
      const popover = this.querySelector<HTMLElement>(".annotation-popover")!
      this.#popover = new HoverPopover<string>({
        popover,
        find: (target) => {
          const highlight = target.closest?.<HTMLElement>(".highlight")
          const id = highlight?.dataset.annotation
          return highlight && id && this.contains(highlight) ? { anchor: highlight, key: id } : undefined
        },
        fill: (id) => this.#fillPopover(popover, id),
        // Each annotation's popover opens at its top, however far the last one was scrolled.
        opened: () => (popover.scrollTop = 0),
      })
      this.#cleanups.push(this.#popover.connect())

      this.#listen()
      // The annotation the address names, selected as the page opens: its card is gone to now, and
      // its passage once the document has its boxes.
      const id = idIn(location.hash)
      if (id && this.#card(id)) {
        this.#select(id, false)
        this.#pending = id
      }
      void this.#open()
    }

    disconnectedCallback() {
      this.#disconnected = true
      this.#cleanups.splice(0).forEach((cleanup) => cleanup())
      cancelAnimationFrame(this.#queued)
      this.#shown?.destroy()
      this.#shown = undefined
    }

    async #open() {
      const failed = () => {
        this.dataset.state = "failed"
        this.querySelector<HTMLElement>("[data-loading]")!.hidden = true
        this.querySelector(".to-document .label")!.textContent = "Go to the annotations"
        const source = this.querySelector(".prose > .annotated-document")
        if (source && !source.querySelector(".unavailable")) {
          const note = document.createElement("span")
          note.className = "unavailable"
          note.textContent = " (PDF not available)"
          source.append(note)
        }
      }
      try {
        const { show } = await import("./document.ts")
        if (this.#disconnected) return
        const passages = JSON.parse(this.dataset.passages ?? "[]") as AnnotatedPassage[]
        this.#shown = show(this.dataset.src!, this.#pages, passages, {
          opened: (places) => this.#opened(places),
          failed,
        }, this.dataset.text)
      } catch {
        failed()
      }
    }

    // The document's boxes are laid out: the cards whose passage it has no place for go last, under a
    // heading of their own, and the page takes the layout that fits it.
    #opened(places: Map<string, Place>) {
      this.#places = places
      this.dataset.state = "opened"
      this.querySelector<HTMLElement>("[data-loading]")!.hidden = true
      const section = this.#section
      if (section) {
        const unplaced = this.#cards().filter((card) => !this.#placeOf(card))
        if (unplaced.length) {
          const heading = document.createElement("h3")
          heading.className = "unplaced"
          heading.textContent = "Not found in the document"
          section.append(heading, ...unplaced)
        }
        // A passage found in the document is a control that shows it there.
        for (const card of this.#cards()) {
          const passage = card.querySelector<HTMLElement>(":scope > .annotation-highlight")
          if (!passage || !places.has(idOf(card))) continue
          passage.setAttribute("role", "button")
          passage.tabIndex = 0
          passage.title = "Show this passage in the document"
        }
      }
      const resized = new ResizeObserver(() => this.#relayout())
      resized.observe(this)
      this.#cleanups.push(() => resized.disconnect())
      this.#apply()
      if (this.#pending) {
        const id = this.#pending
        this.#pending = undefined
        requestAnimationFrame(() => this.#selected === id && this.#go(id, false))
      }
    }

    // The annotation whose passage a card is placed by: its own, or, for a reply, which has none, the
    // one it answers, which comes before it. None where the document has no place for it.
    #placeOf(card: HTMLElement): string | undefined {
      for (let at: Element | null = card; at?.classList.contains("annotation"); at = at.previousElementSibling) {
        if (this.#places.has(idOf(at))) return idOf(at)
        if (at.querySelector(":scope > .annotation-highlight")) return undefined
      }
      return undefined
    }

    // Where a passage starts, down the window, from where the document's text puts it on its page:
    // known before the page is drawn, and the same once it is.
    #passageY(id: string): number | undefined {
      const place = this.#places.get(id)
      const page = place && this.#pages.querySelector(`.document-page[data-page="${place.page + 1}"]`)
      if (!place || !page) return undefined
      const box = page.getBoundingClientRect()
      return box.top + place.top * box.height
    }

    // Once a frame at most, however many things change at once.
    #relayout() {
      if (this.#queued) return
      this.#queued = requestAnimationFrame(() => {
        this.#queued = 0
        this.#apply()
      })
    }

    // Takes the layout that fits the viewer's width now, at the zoom.
    #apply() {
      if (this.dataset.state !== "opened") return
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16
      const next = fit({ available: this.clientWidth, card: toPx(this.dataset.cardWidth!, rem) }, this.#zoom)
      // The drawer turned from a tablet's into a phone's, or back, is taken at once: nothing slides
      // into place, as the drawer would slide shut.
      if (this.#fit && next.mobile !== this.#fit.mobile) {
        if (this.#drawerOpen) this.#setDrawer(false, false)
        this.setAttribute("data-switching", "")
        requestAnimationFrame(() => requestAnimationFrame(() => this.removeAttribute("data-switching")))
      }
      this.#fit = next
      this.#layout = "drawer"
      this.dataset.layout = "drawer"
      this.dataset.drawer = next.mobile ? "mobile" : "tablet"
      this.style.setProperty("--document-width", `${next.documentWidth}px`)
      // Where the bar stays: under a phone's menu bar, which is as tall as its width lets it be.
      this.style.setProperty("--covered", `${this.#covered}px`)
      this.querySelector(".level")!.textContent = `${Math.round(this.#zoom * 100)}%`
      this.querySelector<HTMLButtonElement>("[data-zoom='out']")!.disabled = this.#zoom <= ZOOMS[0]! + 0.001
      this.querySelector<HTMLButtonElement>("[data-zoom='in']")!.disabled = this.#zoom >= ZOOMS.at(-1)! - 0.001
      this.querySelector(".tab")!.setAttribute("tabindex", "0")
      this.#mark()
      this.#restore()
    }

    // Marks the selected annotation's card and highlights, and, once the document is shown, shortens
    // every other card in the drawer while one is selected.
    #mark() {
      for (const highlight of this.querySelectorAll<HTMLElement>(".highlight")) {
        highlight.classList.toggle("selected", highlight.dataset.annotation === this.#selected)
      }
      for (const card of this.#cards()) {
        const selected = idOf(card) === this.#selected
        card.toggleAttribute("data-selected", selected)
        card.classList.toggle("short", !selected && this.#layout !== "static" && this.#selected !== undefined)
        if (selected) card.setAttribute("aria-current", "true")
        else card.removeAttribute("aria-current")
      }
    }

    // The popover over a highlight: its annotation's card whole, and any replies to it, each without
    // its passage where it has a comment, since the passage is what the pointer is on. The cards' ids
    // and links to themselves are the drawer's.
    #fillPopover(popover: HTMLElement, id: string): boolean {
      const cards = this.#cards().filter((card) => this.#placeOf(card) === id)
      if (!cards.length) return false
      const copies = cards.map((card) => {
        const copy = card.cloneNode(true) as HTMLElement
        copy.removeAttribute("id")
        copy.removeAttribute("data-selected")
        copy.removeAttribute("aria-current")
        copy.classList.remove("short")
        for (const element of copy.querySelectorAll("[id]")) element.removeAttribute("id")
        copy.querySelector(":scope > .annotation-anchor")?.remove()
        if (copy.querySelector(":scope > .annotation-comment")) copy.querySelector(":scope > .annotation-highlight")?.remove()
        return copy
      })
      popover.replaceChildren(...copies)
      return true
    }

    // Scrolls the page so that a point `y` down the window sits a little below its top, or a phone's
    // menu bar, or, for a point of the document, below the document's bar.
    #reveal(y: number, smoothly: boolean, covered = this.#covered) {
      window.scrollTo({ top: Math.max(0, window.scrollY + y - covered - BELOW_BAR), behavior: smoothly ? "smooth" : "instant" })
    }

    // Goes past the preface to the document, with its bar just over it, and gives it the focus, so
    // the keys and the next Tab start there. With no document to show, the annotations under the
    // source take the focus.
    #toDocument() {
      const failed = this.dataset.state === "failed"
      const region = failed && this.#section ? this.#section : this.querySelector<HTMLElement>(".document")!
      const source = (failed && this.querySelector<HTMLElement>(".prose > .annotated-document")) || this.querySelector<HTMLElement>(".frame")!
      const smoothly = !matchMedia("(prefers-reduced-motion: reduce)").matches
      this.#reveal(source.getBoundingClientRect().top + BELOW_BAR - 16, smoothly)
      region.focus({ preventScroll: true })
    }

    // Goes to an annotation: its passage where the document is shown and has one, its card otherwise.
    #go(id: string, smoothly = true) {
      const card = this.#card(id)
      const place = card && this.#layout !== "static" ? this.#placeOf(card) : undefined
      const y = place === undefined ? undefined : this.#passageY(place)
      if (y !== undefined) this.#reveal(y, smoothly, this.#coveredOverDocument)
      else card?.scrollIntoView({ block: "nearest", behavior: smoothly ? "smooth" : "instant" })
    }

    /** Selects an annotation, or clears the selection, and says so in the address; goes to it if `going`. */
    #select(id: string | undefined, going: boolean) {
      this.#selected = id && this.#card(id) ? id : undefined
      this.#mark()
      const url = new URL(location.href)
      url.hash = this.#selected ? `#^${this.#selected}` : ""
      if (url.href !== location.href) history.replaceState(history.state, "", url.href.replace(/#$/, ""))
      if (this.#selected && going) this.#go(this.#selected)
    }

    // --- The drawer ---------------------------------------------------------------------------------

    #modal = () => this.#layout === "drawer" && this.#fit?.mobile === true

    // Opens or closes the drawer. A phone's takes the focus while it is open, and gives it back.
    #setDrawer(open: boolean, focus = true) {
      if ((open && this.#layout !== "drawer") || open === this.#drawerOpen) return
      this.#drawerOpen = open
      this.dataset.drawerOpen = String(open)
      this.querySelector(".tab")!.setAttribute("aria-expanded", String(open))
      const section = this.#section
      if (open && this.#modal() && focus) {
        this.#returnFocus = document.activeElement as HTMLElement | null
        section?.focus({ preventScroll: true })
      } else if (!open && this.#returnFocus) {
        if (section?.contains(document.activeElement)) this.#returnFocus.focus({ preventScroll: true })
        this.#returnFocus = null
      }
    }

    // A drag from the tab, out; or across the open drawer, back to the right. The document keeps its
    // own touch: a swipe on it never opens the drawer.
    #drag(from: HTMLElement, opens: boolean) {
      this.#on(from, "pointerdown", (event: PointerEvent) => {
        const section = this.#section
        if (this.#layout !== "drawer" || event.button !== 0 || !section) return
        if (!opens && (!this.#drawerOpen || event.pointerType === "mouse")) return
        const [startX, startY] = [event.clientX, event.clientY]
        const width = section.getBoundingClientRect().width
        let dx = 0
        let dragging = false
        const move = (each: PointerEvent) => {
          dx = each.clientX - startX
          if (!dragging && Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(each.clientY - startY)) {
            dragging = true
            this.setAttribute("data-dragging", "")
          }
          // The drawer follows the finger: out from the edge while closed, back to it while open.
          if (dragging) section.style.transform = `translateX(${this.#drawerOpen ? Math.max(0, dx) : Math.max(0, width + dx)}px)`
        }
        const up = () => {
          window.removeEventListener("pointermove", move)
          window.removeEventListener("pointerup", up)
          window.removeEventListener("pointercancel", up)
          section.style.transform = ""
          this.removeAttribute("data-dragging")
          if (!dragging) return
          // A drag ends in a click on what was dragged, which is no tap.
          this.#dragged = true
          setTimeout(() => (this.#dragged = false))
          if (!this.#drawerOpen && opens && dx < -SWIPE) this.#setDrawer(true)
          else if (this.#drawerOpen && dx > SWIPE) this.#setDrawer(false)
        }
        // On the window, since the pointer soon leaves a tab this narrow.
        window.addEventListener("pointermove", move)
        window.addEventListener("pointerup", up)
        window.addEventListener("pointercancel", up)
      })
    }

    // Tab and Shift-Tab go round the drawer's own links and cards while a phone's drawer is open.
    #trapTab(event: KeyboardEvent) {
      const section = this.#section!
      const focusable = [...section.querySelectorAll<HTMLElement>("a[href], button, [tabindex]:not([tabindex='-1'])")].filter(
        (el) => el.offsetParent !== null,
      )
      event.preventDefault()
      if (!focusable.length) return
      const at = focusable.indexOf(document.activeElement as HTMLElement)
      const next = event.shiftKey ? (at <= 0 ? focusable.length - 1 : at - 1) : at === -1 || at === focusable.length - 1 ? 0 : at + 1
      focusable[next]!.focus()
    }

    // --- Zoom -------------------------------------------------------------------------------------

    // The point of the document to keep where it is across a zoom: a page, where on it, and where in
    // the window it was. Held until the pages have their new size, or a moment has passed.
    #hold: { page: HTMLElement; share: number; fx: number; fy: number; x: number; y: number; until: number } | undefined

    #holdAt(x: number, y: number) {
      const pages = [...this.#pages.querySelectorAll<HTMLElement>(".document-page")]
      if (!pages.length) return
      const page = pages.find((each) => each.getBoundingClientRect().bottom >= y) ?? pages.at(-1)!
      const box = page.getBoundingClientRect()
      const share = box.width / this.#pages.getBoundingClientRect().width
      this.#hold = { page, share, fx: (x - box.left) / box.width, fy: (y - box.top) / box.height, x, y, until: performance.now() + 1500 }
    }

    #restore() {
      const hold = this.#hold
      if (!hold || !this.#fit) return
      const box = hold.page.getBoundingClientRect()
      window.scrollBy({ top: box.top + hold.fy * box.height - hold.y, behavior: "instant" })
      this.querySelector(".document")!.scrollLeft += box.left + hold.fx * box.width - hold.x
      const sized = Math.abs(box.width - hold.share * this.#fit.documentWidth) < 1
      if (sized || performance.now() > hold.until) this.#hold = undefined
    }

    #zoomTo(zoom: number, around?: { x: number; y: number }) {
      const next = clampZoom(zoom)
      if (Math.abs(next - this.#zoom) < 0.001 || this.#layout === "static") return
      // The middle of the document's part of the window, under its bar, by default: the buttons' zoom.
      const top = this.#coveredOverDocument
      this.#holdAt(around?.x ?? window.innerWidth / 2, around?.y ?? top + (window.innerHeight - top) / 2)
      this.#zoom = next
      this.#apply()
    }

    // --- The reader's hands -------------------------------------------------------------------------

    #listen() {
      // A highlight, or its popover, selects its annotation, and opens the drawer at its card. A
      // link in the popover is followed instead. A card, but not a link in it, selects its
      // annotation and takes the document to its passage, leaving the drawer open, so the card just
      // tapped stays in front of the reader.
      this.#on(this, "click", (event: MouseEvent) => {
        const target = event.target as Element
        const highlight = target.closest<HTMLElement>(".highlight")
        const popover = target.closest(".annotation-popover") ? this.#popover?.wanted?.key : undefined
        if (target.closest(".annotation-popover a[href]")) return
        const id = highlight?.dataset.annotation ?? popover
        if (id) {
          event.preventDefault()
          this.#popover?.close()
          this.#select(id, false)
          if (this.#layout === "drawer" && this.#selected) {
            this.#setDrawer(true)
            this.#card(this.#selected)?.scrollIntoView({ block: "nearest" })
          }
          return
        }
        const card = target.closest<HTMLElement>("section.annotations > .annotation")
        if (!card || target.closest("a") || this.#dragged || this.#layout === "static") return
        this.#select(idOf(card), true)
      })

      // Enter or Space on a passage that is in the document.
      this.#on(this, "keydown", (event: KeyboardEvent) => {
        if (event.key !== "Enter" && event.key !== " ") return
        const passage = (event.target as Element).closest(".annotation-highlight[role='button']")
        const card = passage?.closest<HTMLElement>(".annotation")
        if (!card) return
        event.preventDefault()
        this.#select(idOf(card), true)
      })

      // A link to one of the page's annotations, from its preface say.
      this.#on(window, "hashchange", () => {
        const id = idIn(location.hash)
        if (id && this.#card(id)) this.#select(id, true)
      })

      // Hovering a card tints its highlights.
      const hover = (id: string | undefined) => {
        for (const highlight of this.querySelectorAll<HTMLElement>(".highlight")) {
          highlight.classList.toggle("hovered", id !== undefined && highlight.dataset.annotation === id)
        }
      }
      this.#on(this, "mouseover", (event: MouseEvent) => {
        const card = (event.target as Element).closest<HTMLElement>("section.annotations > .annotation")
        hover(card ? idOf(card) : undefined)
      })
      this.#on(this, "mouseleave", () => hover(undefined))

      const tab = this.querySelector<HTMLElement>(".tab")!
      this.#drag(tab, true)
      this.#on(tab, "click", () => {
        if (!this.#dragged) this.#setDrawer(!this.#drawerOpen)
      })
      const section = this.#section
      if (section) this.#drag(section, false)
      this.#on(this.querySelector(".scrim")!, "click", () => this.#setDrawer(false))

      // Focus stays in a phone's drawer while it is open.
      this.#on(document, "focusin", (event: FocusEvent) => {
        if (this.#drawerOpen && this.#modal() && !this.#section?.contains(event.target as Node)) {
          this.#section?.focus({ preventScroll: true })
        }
      })

      // The bar's buttons zoom as the keys do, around the middle of the window.
      for (const button of this.querySelectorAll<HTMLButtonElement>(".zoom button")) {
        this.#on(button, "click", () => {
          const by = button.dataset.zoom
          this.#zoomTo(by === "reset" ? 1 : steppedZoom(this.#zoom, by === "out" ? -1 : 1))
        })
      }

      // The link over the preface, which leaves the page's address as it is.
      this.#on(this.querySelector(".to-document")!, "click", (event: MouseEvent) => {
        event.preventDefault()
        this.#toDocument()
      })

      this.#on(document, "keydown", (event: KeyboardEvent) => {
        if (event.key === "Tab" && this.#drawerOpen && this.#modal()) return this.#trapTab(event)
        if (typing(event)) return
        if (event.key === "Escape") {
          if (this.#drawerOpen) this.#setDrawer(false)
          else if (this.#selected) this.#select(undefined, false)
          return
        }
        if (this.#layout !== "static" && ["+", "=", "-", "0"].includes(event.key)) {
          event.preventDefault()
          return this.#zoomTo(event.key === "0" ? 1 : steppedZoom(this.#zoom, event.key === "-" ? -1 : 1))
        }
        if (event.key !== "j" && event.key !== "k") return
        const order = this.#cards().map(idOf)
        const at = this.#selected ? order.indexOf(this.#selected) : -1
        const next =
          event.key === "j" ? (at === -1 ? 0 : Math.min(order.length - 1, at + 1)) : at === -1 ? order.length - 1 : Math.max(0, at - 1)
        if (order[next] === undefined) return
        event.preventDefault()
        this.#select(order[next], true)
      })

      // Two fingers on the document pinch it, not the page: the drawn pages are scaled live around
      // the fingers' midpoint, and on release drawn again at the new width, with the point under the
      // fingers kept under them. Heard on the document, since a second finger's touch can go to
      // whatever is hit first; it is a pinch of the document if either finger started on it.
      const scroller = this.querySelector<HTMLElement>(".document")!
      const spread = (touches: TouchList) =>
        Math.hypot(touches[0]!.clientX - touches[1]!.clientX, touches[0]!.clientY - touches[1]!.clientY)
      let pinch: { from: number; zoom: number; mid: { x: number; y: number }; scale: number } | undefined
      this.#on(document, "touchstart", (event: TouchEvent) => {
        const touches = [...event.touches]
        if (this.#layout === "static" || touches.length !== 2 || !touches.some((touch) => scroller.contains(touch.target as Node))) return
        const [a, b] = touches as [Touch, Touch]
        const mid = { x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2 }
        pinch = { from: spread(event.touches), zoom: this.#zoom, mid, scale: 1 }
        const box = this.#pages.getBoundingClientRect()
        this.#pages.style.transformOrigin = `${mid.x - box.left}px ${mid.y - box.top}px`
      })
      this.#on(
        document,
        "touchmove",
        (event: TouchEvent) => {
          if (!pinch || event.touches.length !== 2) return
          event.preventDefault()
          pinch.scale = clampZoom(pinch.zoom * (spread(event.touches) / pinch.from)) / pinch.zoom
          this.#pages.style.transform = `scale(${pinch.scale})`
        },
        { passive: false },
      )
      const release = (event: TouchEvent) => {
        if (!pinch || event.touches.length >= 2) return
        const { zoom, scale, mid } = pinch
        pinch = undefined
        this.#pages.style.transform = ""
        this.#pages.style.transformOrigin = ""
        this.#zoomTo(zoom * scale, mid)
      }
      this.#on(document, "touchend", release)
      this.#on(document, "touchcancel", release)
    }
  }

  customElements.define("annotation-viewer", AnnotationViewer)
</script>

<style>
  .annotation-viewer {
    display: block;
  }

  /* The link past the preface to the document: a line of the note's column, over the preface, once
     the document is shown, or to the annotations where it can't be. None where
     there is no preface to go past. */
  .to-document {
    display: none;
  }

  .annotation-viewer:is([data-layout="drawer"], [data-state="failed"]):has(.annotation-preface) .to-document {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    box-sizing: border-box;
    width: min(100%, var(--noteWidth));
    margin: 0 auto 1rem;
    color: var(--darkgray);
    font-size: 0.9rem;
  }

  .to-document:hover {
    color: var(--secondary);
  }

  /* The document is given the focus by that link, as a place to start from: no ring. */
  .document:focus {
    outline: none;
  }

  /* The document and its bar: out of sight until it opens. */
  .frame {
    display: none;
    min-width: 0;
  }

  .annotation-viewer[data-layout="drawer"] .frame {
    display: block;
  }

  /* The bar stays at the top of the window, under a phone's menu bar, while any of the document is
     in view, and goes with its last page. Over the highlights, which are over the pages. */
  .bar {
    position: sticky;
    top: var(--covered, 0px);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--lightgray);
    background: var(--light);
  }

  /* Its buttons stay clear of a desktop's drawer, which opens over the right of the window. */
  .annotation-viewer[data-drawer="tablet"][data-drawer-open="true"] .bar {
    padding-right: calc(var(--card-width) + 0.75rem);
  }

  .about {
    flex: 1;
    min-width: 0;
  }

  .about p {
    margin: 0;
  }

  .title {
    overflow: hidden;
    color: var(--dark);
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .retrieved {
    color: var(--darkgray);
    font-size: 0.8rem;
  }

  .retrieved a {
    font-weight: 500;
  }

  .zoom {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    border: 1px solid var(--lightgray);
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .zoom button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.375rem;
    border: 0;
    background: none;
    color: var(--darkgray);
    font: inherit;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  .zoom button + button {
    border-left: 1px solid var(--lightgray);
  }

  .zoom button:hover:not(:disabled) {
    background: var(--highlight);
    color: var(--dark);
  }

  .zoom button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .zoom button:focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: -2px;
  }

  .level {
    min-width: 2.75rem;
  }

  /* The document pans sideways in its column when it is zoomed wider than it, and never scrolls
     down by itself: the page is the one scroll. */
  .document {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    /* Two fingers pinch the document, not the page; one scrolls and pans. */
    touch-action: pan-x pan-y;
  }

  .status {
    margin: 0;
    padding: 1rem 0;
    color: var(--darkgray);
  }

  .pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: var(--document-width, 100%);
    margin: 0 auto;
  }

  /* What PDF.js draws is made by the element's script, which scoped styles never reach. A page is
     paper, white in either scheme, ruled off from the next. */
  .pages :global(.document-page) {
    position: relative;
    flex-shrink: 0;
    background: var(--paper);
    outline: 1px solid var(--lightgray);
  }

  .pages :global(.document-page canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* A passage, each line of it, over the text a reader can select. */
  .pages :global(.highlight) {
    position: absolute;
    z-index: 2;
    border-radius: 2px;
    background: var(--textHighlight);
    cursor: pointer;
  }

  .pages :global(.highlight.selected) {
    outline: 2px solid var(--secondary);
  }

  .pages :global(.highlight:focus-visible) {
    outline: 2px solid var(--secondary);
    outline-offset: 1px;
  }

  /* A card being hovered tints its highlights. */
  .pages :global(.highlight.hovered) {
    box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--tertiary) 35%, transparent);
  }

  /* PDF.js's text layer: transparent text laid over the drawing, so it can be selected and found,
     as in the PDF viewer widget (src/components/widgets/pdf-viewer/pdf-viewer.module.css), from
     PDF.js 5.4.530's web/text_layer_builder.css. The script writes --total-scale-factor on the page,
     and PDF.js writes --min-font-size on the layer, and --font-height, --scale-x and --rotate on
     each span. */
  .pages :global(.text-layer) {
    --pdf-text-scale: calc(var(--total-scale-factor) * var(--min-font-size));
    --pdf-min-font-size-inv: calc(1 / var(--min-font-size));
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: clip;
    opacity: 1;
    line-height: 1;
    text-align: initial;
    -webkit-text-size-adjust: none;
    text-size-adjust: none;
    forced-color-adjust: none;
    transform-origin: 0 0;
  }

  .pages :global(.text-layer :is(span, br)) {
    position: absolute;
    color: transparent;
    white-space: pre;
    cursor: text;
    transform-origin: 0% 0%;
  }

  .pages :global(.text-layer > :not(.markedContent)),
  .pages :global(.text-layer .markedContent span:not(.markedContent)) {
    z-index: 1;
    font-size: calc(var(--pdf-text-scale) * var(--font-height, 0px));
    transform: rotate(var(--rotate, 0deg)) scaleX(var(--scale-x, 1)) scale(var(--pdf-min-font-size-inv));
  }

  .pages :global(.text-layer .markedContent) {
    display: contents;
  }

  .pages :global(.text-layer span[role="img"]) {
    cursor: default;
    user-select: none;
  }

  .pages :global(.text-layer ::selection) {
    background: var(--textHighlight);
    color: transparent;
  }

  .pages :global(.text-layer br::selection) {
    background: transparent;
  }

  /* The drawer's tab, on the right edge, riding the drawer's edge while it is open; and what dims the
     document behind a phone's drawer. Neither is anywhere but in the drawer's layout. */
  .tab,
  .scrim {
    display: none;
  }

  .annotation-viewer[data-layout="drawer"] .tab {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 19;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 4rem;
    padding: 0;
    border: 1px solid var(--lightgray);
    border-right: 0;
    border-radius: 0.5rem 0 0 0.5rem;
    background: var(--light);
    cursor: grab;
    touch-action: none;
    transform: translateY(-50%);
    transition: right 0.2s ease;
  }

  .annotation-viewer[data-layout="drawer"][data-drawer-open="true"] .tab {
    right: var(--card-width);
  }

  .annotation-viewer[data-layout="drawer"][data-drawer="mobile"][data-drawer-open="true"] .tab {
    right: 85vw;
    z-index: 41;
  }

  .grip {
    width: 0.25rem;
    height: 1.5rem;
    border-radius: 0.125rem;
    background: var(--gray);
  }

  .annotation-viewer[data-layout="drawer"][data-drawer="mobile"] .scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: block;
    background: var(--scrim);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .annotation-viewer[data-layout="drawer"][data-drawer="mobile"][data-drawer-open="true"] .scrim {
    opacity: 1;
    pointer-events: auto;
  }

  /* A highlight's annotation, beside it: its card, and any replies, ruled off from each other, in a
     box as wide as the drawer, and over it, as a link's preview is (LinkPopovers.astro). */
  .annotation-popover {
    inset: auto;
    margin: 0;
    box-sizing: border-box;
    width: min(var(--card-width), 100vw - 1rem);
    max-height: 24rem;
    padding: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--lightgray);
    border-radius: 0.5rem;
    background: var(--light);
    color: var(--darkgray);
    box-shadow: 0 1rem 3rem var(--shadow);
    /* The whole of it opens its card in the drawer, as its highlight does. */
    cursor: pointer;
  }

  .annotation-popover :global(.annotation) {
    margin: 0;
    border: none;
    border-radius: 0;
    background: none;
  }

  .annotation-popover :global(.annotation + .annotation) {
    border-top: 1px solid var(--lightgray);
  }

  .annotation-viewer[data-switching] .tab {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tab,
    .scrim {
      transition: none !important;
    }
  }
</style>
