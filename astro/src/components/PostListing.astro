---
// The post listings: the site's posts in each of the orders site configuration names, newest first
// or most central first. Each post with its title, its date, its description and its tags as tag
// badges. On a tag page, the posts under its tag; on the 404 page, every post: one listing at a
// time, in a carousel the reader moves through (Carousel.astro: with no script, the reader swipes or
// scrolls it; with script, buttons step through it). On the home page, the first few of each
// listing, `postListing.home`, one listing under the other, with no carousel
// (src/lib/post-listing.ts).
// Each listing's posts are set by PostList.astro, which shows the first few and the rest on asking.
import Carousel from "./Carousel.astro"
import { centralPosts, listedPosts, postCounts } from "../lib/post-listing.ts"
import type { Note } from "../lib/notes.ts"
import type { PostOrder } from "../site.config.types.ts"
import { mentionCounts } from "../lib/mentions.ts"
import { getMentions } from "../lib/note-discussion.ts"
import { postListing, webmentions } from "../site.config.ts"
import { annotatedFileType } from "../lib/annotations.ts"
import PostList from "./PostList.astro"

interface Props {
  /** On a tag page, the tag whose posts are listed. */
  tag?: string | undefined
  /** Whether it is the home page's: a few of each listing, one under the other. */
  home?: boolean
}

const { tag, home = false } = Astro.props
const mentions = mentionCounts(await getMentions(), webmentions.blockedDomains)
const postsIn: Record<PostOrder, () => Note[]> = {
  recent: () => listedPosts(tag),
  central: () => centralPosts(tag, { mentions }),
}
const all = home
  ? postListing.home.map((listing) => ({ ...listing, posts: postsIn[listing.order]().slice(0, listing.limit) }))
  : postListing.listings.map((listing) => ({ ...listing, posts: postsIn[listing.order]() }))
const withPosts = all.filter((listing) => listing.posts.length > 0)
const listings = withPosts.length > 0 ? withPosts : all.slice(0, 1)
const counts = postListing.showTagCounts ? postCounts() : undefined
---

{
  home ? (
    <div class="post-listings stacked">
      {listings.map(({ order, title, posts }) => (
        <section class="post-listing" data-order={order} aria-labelledby={`post-listing-${order}`}>
          <h2 id={`post-listing-${order}`}>{title}</h2>
          {posts.length === 0 && <p class="empty">{postListing.emptyText}</p>}
          <PostList
            pages={posts.map((note) => ({ ...note, description: note.summary, fileType: annotatedFileType(note) }))}
            noun={["post", "posts"]}
            counts={counts}
          />
        </section>
      ))}
    </div>
  ) : (
    <Carousel
      class="post-listings"
      slideClass="post-listing"
      noun="listing"
      id="post-listing"
      slides={listings.map(({ order, title }) => ({ key: order, title, attributes: { "data-order": order } }))}
    >
      {
        listings.map(({ order, posts }) => (
          <Fragment slot={order}>
            {posts.length === 0 && <p class="empty">{postListing.emptyText}</p>}
            <PostList
              pages={posts.map((note) => ({ ...note, description: note.summary, fileType: annotatedFileType(note) }))}
              noun={["post", "posts"]}
              counts={counts}
            />
          </Fragment>
        ))
      }
    </Carousel>
  )
}

<style>
  /* One listing under the other, as far apart as the sections after a page's body are. */
  .stacked {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .stacked .post-listing {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* As a carousel's slide's heading is spaced (Carousel.astro). */
  .stacked .post-listing > h2 {
    margin: 0 0 0.5rem;
  }

  .empty {
    margin: 0;
    color: var(--darkgray);
  }
</style>
