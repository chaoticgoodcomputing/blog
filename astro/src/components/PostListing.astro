---
// The post listings: the site's posts in each of the orders site configuration names, newest first
// or most central first. Each post with its title, its date, its description and its tags as tag
// badges. On a tag page, the posts under its tag; on the home page and the 404 page, every post.
// The same listings on each kind of page, set out as `postListing.pages` says: one under the other,
// or one at a time in a carousel the reader moves through (Carousel.astro: with no script, the
// reader swipes or scrolls it; with script, buttons step through it) (src/lib/post-listing.ts).
// Each listing's posts are set by PostList.astro, a page at a time.
import Carousel from "./Carousel.astro"
import { centralPosts, listedPosts, listingsOn, postCounts } from "../lib/post-listing.ts"
import type { Note } from "../lib/notes.ts"
import type { ListingPageKind, PostOrder } from "../site.config.types.ts"
import { mentionCounts } from "../lib/mentions.ts"
import { getMentions } from "../lib/note-discussion.ts"
import { postListing, webmentions } from "../site.config.ts"
import { annotatedFileType } from "../lib/annotations.ts"
import PostList from "./PostList.astro"

interface Props {
  /** The kind of page it is on, which says how its listings are set out. */
  kind: ListingPageKind
  /** On a tag page, the tag whose posts are listed. */
  tag?: string | undefined
}

const { kind, tag } = Astro.props
const mentions = mentionCounts(await getMentions(), webmentions.blockedDomains)
const postsIn: Record<PostOrder, () => Note[]> = {
  recent: () => listedPosts(tag),
  central: () => centralPosts(tag, { mentions }),
}
const { layout, listings: all } = listingsOn(kind)
const withPages = all.map((listing) => ({
  ...listing,
  pages: postsIn[listing.order]().map((note) => ({ ...note, description: note.summary, fileType: annotatedFileType(note) })),
}))
const withPosts = withPages.filter((listing) => listing.pages.length > 0)
const listings = withPosts.length > 0 ? withPosts : withPages.slice(0, 1)
const counts = postListing.showTagCounts ? postCounts() : undefined
---

{
  layout === "stacked" ? (
    <div class="post-listings stacked">
      {listings.map(({ order, title, pages, show, more }) => (
        <section class="post-listing" data-order={order} aria-labelledby={`post-listing-${order}`}>
          <h2 id={`post-listing-${order}`}>{title}</h2>
          {pages.length === 0 && <p class="empty">{postListing.emptyText}</p>}
          <PostList pages={pages} counts={counts} show={show} more={more} />
        </section>
      ))}
    </div>
  ) : (
    <Carousel
      class="post-listings"
      slideClass="post-listing"
      noun="listing"
      id="post-listing"
      slides={listings.map(({ order, title }) => ({ key: order, title, attributes: { "data-order": order } }))}
    >
      {listings.map(({ order, pages, show, more }) => (
        <Fragment slot={order}>
          {pages.length === 0 && <p class="empty">{postListing.emptyText}</p>}
          <PostList pages={pages} counts={counts} show={show} more={more} />
        </Fragment>
      ))}
    </Carousel>
  )
}

<style>
  /* One listing under the other, as far apart as the sections after a page's body are. */
  .stacked {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .stacked .post-listing {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* As a carousel's slide's heading is spaced (Carousel.astro). */
  .stacked .post-listing > h2 {
    margin: 0 0 0.5rem;
  }

  .empty {
    margin: 0;
    color: var(--darkgray);
  }
</style>
