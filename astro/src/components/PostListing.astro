---
// The post listings: the site's posts in each of the orders site configuration names, newest first
// or most central first, one listing at a time in a carousel the reader moves through. Each post
// with its title, its date, its description and its tags as tag badges. Every post on the home page
// and the 404 page; on a tag page, the posts under its tag (src/lib/post-listing.ts).
//
// The carousel is the site's own (Carousel.astro): with no script, the reader swipes or scrolls it;
// with script, buttons step through it.
// Each listing's posts are set by PostList.astro, which shows the first few and the rest on asking.
import Carousel from "./Carousel.astro"
import { centralPosts, listedPosts, postCounts } from "../lib/post-listing.ts"
import type { Note } from "../lib/notes.ts"
import type { PostOrder } from "../site.config.types.ts"
import { mentionCounts } from "../lib/mentions.ts"
import { getMentions } from "../lib/note-discussion.ts"
import { postListing, webmentions } from "../site.config.ts"
import { annotatedFileType } from "../lib/annotations.ts"
import PostList from "./PostList.astro"

interface Props {
  /** On a tag page, the tag whose posts are listed. */
  tag?: string | undefined
}

const { tag } = Astro.props
const mentions = mentionCounts(await getMentions(), webmentions.blockedDomains)
const postsIn: Record<PostOrder, () => Note[]> = {
  recent: () => listedPosts(tag),
  central: () => centralPosts(tag, { mentions }),
}
const all = postListing.listings.map((listing) => ({ ...listing, posts: postsIn[listing.order]() }))
const withPosts = all.filter((listing) => listing.posts.length > 0)
const listings = withPosts.length > 0 ? withPosts : all.slice(0, 1)
const counts = postListing.showTagCounts ? postCounts() : undefined
---

<Carousel
  class="post-listings"
  slideClass="post-listing"
  noun="listing"
  id="post-listing"
  slides={listings.map(({ order, title }) => ({ key: order, title, attributes: { "data-order": order } }))}
>
  {
    listings.map(({ order, posts }) => (
      <Fragment slot={order}>
        {posts.length === 0 && <p class="empty">{postListing.emptyText}</p>}
        <PostList
          pages={posts.map((note) => ({ ...note, description: note.summary, fileType: annotatedFileType(note) }))}
          noun={["post", "posts"]}
          counts={counts}
        />
      </Fragment>
    ))
  }
</Carousel>

<style>
  .empty {
    margin: 0;
    color: var(--darkgray);
  }
</style>
