---
// A list of pages as the post listings set them (PostListing.astro), and as what is related to a
// note sets its links and the other sites that mention it (Connections.astro): each by its
// title, a heading, with who wrote it and where under that for another site's, its date and its
// description, and its tags as tag badges. A private page is marked with a lock. A page on another
// site opens in a new tab.
//
// The first few are shown, and the rest a few at a time as the reader asks (PagedList.astro).
import { Icon } from "astro-icon/components"
import { newTab } from "../lib/external-links.ts"
import FileTypeChip from "./FileTypeChip.astro"
import FormattedDate from "./FormattedDate.astro"
import PagedList from "./PagedList.astro"
import TagBadge from "./TagBadge.astro"

/** A page as a list shows it. */
export interface ListedPage {
  url: string
  title: string
  date?: Date | undefined
  /** Who wrote it and where, under its title: another site's page's `<author> at <site>`. */
  byline?: string | undefined
  description?: string | undefined
  tags?: string[] | undefined
  /** For an annotation page, the kind of file it annotates: `pdf`. */
  fileType?: string | undefined
  isPrivate?: boolean | undefined
}

interface Props {
  pages: ListedPage[]
  /** How many posts are under each tag, which its badge says, where it says. */
  counts?: Map<string, number> | undefined
  /** How many it shows at first, and how many more at each asking (PagedList.astro). */
  show?: number | undefined
  more?: number | undefined
}

const { pages, counts, show, more } = Astro.props
const site = Astro.site!.href
// A private page's mark: the icon `mdi:lock`, drawn inline by astro-icon when the site builds, as a
// tag bubble's icon is (docs/adr/1101), in the link's colour.
const lock = "mdi:lock"
---

{
  pages.length > 0 && (
    <PagedList show={show} more={more}>
      <ul class="posts">
        {pages.map((page) => (
          <li class="post">
            <h3>
              <a href={page.url} {...newTab(page.url, site)}>
                {page.isPrivate && (
                  <Icon name={lock} is:inline role="img" aria-label="Private page" width="0.75em" height="0.75em" fill="currentColor" />
                )}
                {page.isPrivate && " "}
                {page.title}
                {page.fileType && <FileTypeChip type={page.fileType} />}
              </a>
            </h3>
            {page.byline && <p class="byline">{page.byline}</p>}
            {(page.date || page.description) && (
              <p class="meta">
                {page.date && <FormattedDate date={page.date} />}
                {page.description && <span class="description">{`${page.date ? " — " : ""}${page.description}`}</span>}
              </p>
            )}
            {page.tags && page.tags.length > 0 && (
              <ul class="tags">
                {page.tags.map((tag) => (
                  <li>
                    <TagBadge tag={tag} count={counts?.get(tag)} />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </PagedList>
  )
}

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  h3 {
    margin: 0;
  }

  h3 a {
    text-decoration: none;
  }

  .meta {
    margin: 0.25rem 0 0;
    color: var(--darkgray);
  }

  /* Under the title, centred as it is, and quieter. */
  .byline {
    margin: 0.1rem 0 0;
    color: var(--darkgray);
    font-size: 0.9em;
    font-style: italic;
    text-align: center;
  }

  /* Centred, as the post's title over them is. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .tags li {
    max-width: 100%;
  }
</style>
