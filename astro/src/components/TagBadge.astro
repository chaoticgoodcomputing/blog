---
// A tag badge: a tag bubble, then `#` and the tag name, as one link to the tag's page. How a tag
// appears among text.
//
// A badge is its bubble alone, and grows to show its name, pushing the badges after it along:
// while the pointer is on it or it has the keyboard's focus, or, on a touch screen, once it has been
// held. A tap goes to the tag's page, as a click does; a hold shows the name instead, and the badge
// stays open until the reader touches somewhere else. Either way the name is the link's text, and
// its name for a screen reader.
import { tagName, tagUrl } from "../lib/tags.ts"
import TagBubble from "./TagBubble.astro"

interface Props {
  /** A tag slug. */
  tag: string
  /** How many posts are under the tag, where the badge says so. */
  count?: number | undefined
}

const { tag, count } = Astro.props
---

<a class="tag-badge" href={tagUrl(tag)} title={tag}>
  <TagBubble tag={tag} />
  {/* `#` and the name as one string, so that they never break apart. */}
  <span class="label">
    <span class="text">
      <span class="name">{`#${tagName(tag)}`}</span>
      {count !== undefined && <span class="count">({count})</span>}
    </span>
  </span>
</a>

<script>
  // A hold on a badge, on a touch screen, opens it, `data-open`, rather than going to its page: one
  // listener for every badge on the page, and on every page the client router brings in.

  /** How long a touch is held before it is a hold. */
  const HOLD_MS = 450
  /** How far a touch may move and still be a hold, not a scroll. */
  const SLOP_PX = 10

  let held: { badge: HTMLElement; x: number; y: number; timer: ReturnType<typeof setTimeout> } | undefined
  /** The badge a hold has just opened, whose click, as the touch ends, goes nowhere. */
  let opened: HTMLElement | undefined

  const badgeAt = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLElement>(".tag-badge") : null)

  document.addEventListener("pointerdown", (event) => {
    const badge = badgeAt(event.target)
    // A touch anywhere but an open badge closes every open one.
    for (const open of document.querySelectorAll<HTMLElement>(".tag-badge[data-open]")) {
      if (open !== badge) delete open.dataset.open
    }
    if (event.pointerType !== "touch" || !badge) return
    clearTimeout(held?.timer)
    held = {
      badge,
      x: event.clientX,
      y: event.clientY,
      timer: setTimeout(() => {
        badge.dataset.open = ""
        opened = badge
        held = undefined
      }, HOLD_MS),
    }
  })

  document.addEventListener("pointermove", (event) => {
    if (held && Math.hypot(event.clientX - held.x, event.clientY - held.y) > SLOP_PX) {
      clearTimeout(held.timer)
      held = undefined
    }
  })

  for (const end of ["pointerup", "pointercancel"]) {
    document.addEventListener(end, () => {
      clearTimeout(held?.timer)
      held = undefined
    })
  }

  // The click a hold ends in, and the menu a browser opens on a held link, are the hold's.
  document.addEventListener(
    "click",
    (event) => {
      if (opened && badgeAt(event.target) === opened) event.preventDefault()
      opened = undefined
    },
    { capture: true },
  )
  document.addEventListener("contextmenu", (event) => {
    if (event.target instanceof Element && badgeAt(event.target)?.dataset.open !== undefined) event.preventDefault()
  })
</script>

<style>
  /* The bubble alone, in a circle of the badge's background, the label a column as wide as none of
     it until the badge is open, when it is as wide as all of it. The badge's gap and the room after
     the name are the label's own, so that they go with it. */
  .tag-badge {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.3rem;
    border-radius: 21px;
    background-color: var(--lightgray);
    color: inherit;
    /* A tag is set in the code font, wherever the site shows one. */
    font-family: var(--codeFont);
    text-decoration: none;
    /* A held link is the badge's to open, not the browser's to call out. */
    -webkit-touch-callout: none;
    user-select: none;
    transition:
      background-color 0.2s ease,
      border-radius 0.2s ease;
  }

  /* Open: held on a touch screen, focused, or, where a pointer hovers, hovered. A touch screen's
     tap is not a hover, so that a tap goes to the tag's page at once. */
  .tag-badge:is(:focus-visible, [data-open]) {
    border-radius: 21px 8px 8px 21px;
  }

  .label {
    display: grid;
    grid-template-columns: minmax(0, 0fr);
    min-width: 0;
    overflow: hidden;
    transition: grid-template-columns 0.2s ease;
  }

  .tag-badge:is(:focus-visible, [data-open]) .label {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (hover: hover) {
    .tag-badge:hover {
      border-radius: 21px 8px 8px 21px;
      background-color: var(--gray);
    }

    .tag-badge:hover .label {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .text {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    padding: 0 0.3rem 0 0.5rem;
    white-space: nowrap;
  }

  .name {
    min-width: 0;
    font-size: 0.85em;
    font-weight: 500;
  }

  .count {
    font-size: 0.85em;
    color: var(--darkgray);
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-badge,
    .label {
      transition: none;
    }
  }
</style>
