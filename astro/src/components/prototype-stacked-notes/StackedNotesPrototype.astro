---
// PROTOTYPE: throwaway, on the prototype/stacked-notes branch only. Never merge to main.
//
// Question: what should stacked-note navigation look like on this site, where the path a reader
// takes through the graph is visible? (After notes.andymatuschak.org.)
//
// Three variants, switched with `?variant=A|B|C` on any page, in dev only (Base.astro mounts this
// under `import.meta.env.DEV`). Without `?variant=` the site is as it is.
//
//   A  Trail      Andy's layout: columns, earlier ones collapse to spines. A small map of the
//                 path floats in the corner.
//   B  Graph rail The graph is the navigation: a rail on the left draws every note next to the
//                 path, with the path drawn through it. A click on a node opens it as a column.
//   C  Ribbon     The path unrolled along the top, a station over each column, with arcs for the
//                 links between notes of the path that the path didn't take.
//
// The stack is in the address: `?variant=A&stacked=/a&stacked=/b`, after the page's own path.
// A click on a link in a column closes the columns after it and opens the link's note next to it.

import TagBubble from "../TagBubble.astro"
import { graphOf } from "../../lib/graph.ts"
import { graphIndex } from "../../lib/graph-index.ts"
import { graph } from "../../site.config.ts"

// Every tag's bubble, hidden, for the graph drawing to copy, as the local graph does.
const tags = graphOf(graphIndex(), { removeTags: graph.local.removeTags, privatePages: "mark" })
  .nodes.flatMap((node) => (node.kind === "tag" && node.tag !== undefined ? [node.tag] : []))
---

<div id="sn-root" hidden></div>
<div id="sn-bubbles" hidden>
  {tags.map((tag) => <span data-tag={tag}><TagBubble tag={tag} /></span>)}
</div>

<script>
  import { forceCenter, forceCollide, forceLink, forceManyBody, forceSimulation, type SimulationNodeDatum } from "d3-force"
  import { globalGraph } from "../../lib/global-graph.ts"
  import { neighbourhood, type Graph, type GraphEdge, type GraphNode } from "../../lib/graph.ts"
  import { drawGraph, type DrawnGraph } from "../../lib/graph-drawing.ts"
  import { loadGraphIndex } from "../../lib/graph-index-client.ts"
  import { graph as graphConfig } from "../../site.config.ts"

  const VARIANTS = [
    { key: "A", name: "Trail" },
    { key: "B", name: "Graph rail" },
    { key: "C", name: "Ribbon" },
  ] as const
  type VariantKey = (typeof VARIANTS)[number]["key"]

  const params = new URLSearchParams(location.search)
  const variant = VARIANTS.find((each) => each.key === params.get("variant")?.toUpperCase())?.key

  // ---------------------------------------------------------------------------------------------
  // The stack: which notes are open, in order. Column 0 is the page's own path.

  const normal = (url: string) => {
    const path = decodeURI(new URL(url, location.origin).pathname).replace(/\/$/, "")
    return path === "" ? "/" : path
  }

  let stack: string[] = [normal(location.pathname), ...params.getAll("stacked").map(normal)]

  function writeAddress() {
    const next = new URLSearchParams()
    next.set("variant", current)
    for (const url of stack.slice(1)) next.append("stacked", url)
    history.replaceState(history.state, "", `${encodeURI(stack[0])}?${next}`)
  }

  let current: VariantKey = variant ?? "A"

  // ---------------------------------------------------------------------------------------------
  // A note's column content, fetched from its page: the page's `<main>`, and its backlinks.

  interface Fetched {
    url: string
    title: string
    body: HTMLElement
  }

  const cache = new Map<string, Promise<Fetched>>()
  const seenStyles = new Set<string>()

  function adoptStyles(doc: Document) {
    // A note's page may need styles this page didn't load (a component only it has). In dev they
    // are <style> tags keyed by Vite's id; in a build, stylesheet links.
    for (const each of doc.head.querySelectorAll<HTMLElement>("style, link[rel=stylesheet]")) {
      const key = each.getAttribute("data-vite-dev-id") ?? each.getAttribute("href") ?? each.textContent ?? ""
      if (seenStyles.has(key)) continue
      seenStyles.add(key)
      document.head.append(each.cloneNode(true))
    }
  }
  // A note's page may need a component's script (the annotation viewer's custom element, say) or,
  // in dev, its styles, which Vite also loads as module scripts. A module runs once per address,
  // so loading one this page already has does nothing.
  function adoptScripts(doc: Document) {
    const loaded = new Set([...document.querySelectorAll<HTMLScriptElement>("script[type=module][src]")].map((each) => each.getAttribute("src")))
    for (const each of doc.querySelectorAll<HTMLScriptElement>("script[type=module][src]")) {
      const src = each.getAttribute("src")!
      if (loaded.has(src)) continue
      loaded.add(src)
      document.head.append(Object.assign(document.createElement("script"), { type: "module", src }))
    }
  }

  for (const each of document.head.querySelectorAll<HTMLElement>("style, link[rel=stylesheet]")) {
    seenStyles.add(each.getAttribute("data-vite-dev-id") ?? each.getAttribute("href") ?? each.textContent ?? "")
  }

  function fetchNote(url: string): Promise<Fetched> {
    let found = cache.get(url)
    if (!found) {
      found = fetch(encodeURI(url))
        .then((response) => response.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, "text/html")
          adoptStyles(doc)
          adoptScripts(doc)
          const main = doc.querySelector("main")
          const body = document.createElement("div")
          body.className = "sn-note"
          if (main) {
            // What is under a note and only clutters a column.
            main.querySelectorAll(".subscribe-box, .source-link").forEach((each) => each.remove())
            body.append(...main.childNodes)
          } else {
            body.textContent = `No page at ${url}`
          }
          const backlinks = doc.querySelector(".backlinks")
          if (backlinks) body.append(backlinks)
          const title = doc.querySelector("main h1")?.textContent?.trim() || doc.title || url
          return { url, title, body }
        })
      cache.set(url, found)
    }
    return found
  }

  // ---------------------------------------------------------------------------------------------
  // The graph, from the index every graph is drawn from. Neighbours are notes linked either way.

  let siteGraph: Graph = { nodes: [], edges: [] }
  const nodeById = new Map<string, GraphNode>()
  const neighbours = new Map<string, Set<string>>()

  async function loadGraph() {
    const index = await loadGraphIndex()
    // The global graph's, over every date: the graph drawn is cut from it (pathGraph).
    siteGraph = globalGraph(index, graphConfig.global, { period: "all", includePrivate: graphConfig.global.filters.includePrivate }, new Date())
    for (const node of siteGraph.nodes) {
      nodeById.set(node.id, node)
      neighbours.set(node.id, new Set())
    }
    for (const edge of siteGraph.edges) {
      if (edge.kind !== "noteNote") continue
      neighbours.get(edge.source)?.add(edge.target)
      neighbours.get(edge.target)?.add(edge.source)
    }
  }

  const linked = (a: string, b: string) => neighbours.get(a)?.has(b) ?? false
  const labelOf = (id: string) => nodeById.get(id)?.label ?? id

  // ---------------------------------------------------------------------------------------------
  // Shared DOM: the root, and the scrolling row of columns every variant has.

  const root = document.getElementById("sn-root")!
  let columnsEl: HTMLElement
  let onStackChange: () => void = () => {}

  async function renderColumns() {
    const notes = await Promise.all(stack.map(fetchNote))
    columnsEl.replaceChildren(
      ...notes.map((note, i) => {
        const column = document.createElement("article")
        column.className = "sn-col"
        column.dataset.index = String(i)
        column.dataset.url = note.url
        column.style.setProperty("--i", String(i))
        const spine = document.createElement("a")
        spine.className = "sn-spine"
        spine.href = encodeURI(note.url)
        spine.textContent = labelOf(note.url)
        spine.addEventListener("click", (event) => {
          event.preventDefault()
          event.stopImmediatePropagation()
          if (current === "B") back(i)
          else scrollToColumn(i)
        })
        // The same fetched body can't sit in two places; columns are rebuilt each time, so clone.
        column.append(spine, note.body.cloneNode(true))
        return column
      }),
    )
    markLinks()
    updateSpines()
    onStackChange()
  }

  // Links to an open note are marked; the one that leads to the next column most of all.
  function markLinks() {
    for (const column of columnsEl.querySelectorAll<HTMLElement>(".sn-col")) {
      const i = Number(column.dataset.index)
      for (const a of column.querySelectorAll<HTMLAnchorElement>(".sn-note a[href]")) {
        a.classList.remove("sn-open", "sn-next")
        if (!isInternal(a)) continue
        const target = normal(a.href)
        if (target === stack[i + 1]) a.classList.add("sn-next")
        else if (stack.includes(target)) a.classList.add("sn-open")
      }
    }
  }

  function isInternal(a: HTMLAnchorElement) {
    // A link within the note (a heading, an annotation's `#^id`) is the note's own.
    if (a.getAttribute("href")?.startsWith("#")) return false
    const url = new URL(a.href, location.href)
    return (
      url.origin === location.origin &&
      !url.pathname.startsWith("/assets/") &&
      !/\.(pdf|png|jpe?g|svg|xml|json)$/i.test(url.pathname) &&
      !(url.pathname === location.pathname && url.hash && !url.search)
    )
  }

  function scrollToColumn(i: number) {
    const column = columnsEl.querySelector<HTMLElement>(`.sn-col[data-index="${i}"]`)
    if (!column) return
    // A column sticks at its spine's offset, so its place in the flow is i column widths in.
    const width = column.offsetWidth
    const spine = spineWidth()
    columnsEl.scrollTo({ left: Math.max(0, i * width - i * spine), behavior: "smooth" })
    column.classList.remove("sn-flash")
    void column.offsetWidth
    column.classList.add("sn-flash")
  }

  function spineWidth() {
    const value = parseFloat(getComputedStyle(columnsEl).getPropertyValue("--spine"))
    return Number.isNaN(value) ? 40 : value
  }

  // A column under the ones after it shows only its spine.
  function updateSpines() {
    const columns = [...columnsEl.querySelectorAll<HTMLElement>(".sn-col")]
    if (columns.length === 0) return
    const width = columns[0].offsetWidth
    const spine = spineWidth()
    const left = columnsEl.scrollLeft
    // Where a column's left edge is on screen: where the flow puts it, or where it sticks.
    const edge = (i: number) => Math.max(i * width - left, i * spine)
    columns.forEach((column, i) => {
      // Covered once the next column has slid over most of it.
      const covered = i + 1 < columns.length && edge(i + 1) - edge(i) < width * 0.6
      column.classList.toggle("sn-covered", covered)
    })
  }

  /** Opens `url` after column `from`, closing what was after it. */
  async function open(url: string, from: number) {
    url = normal(url)
    const at = stack.indexOf(url)
    // Already open at or before where it would go: show it there. B shows one note, so it goes back.
    if (at !== -1 && at <= from + 1) return current === "B" ? back(at) : scrollToColumn(at)
    stack = [...stack.slice(0, from + 1), url]
    writeAddress()
    await renderColumns()
    requestAnimationFrame(() => scrollToColumn(stack.length - 1))
  }

  function reset(url: string) {
    stack = [normal(url)]
    writeAddress()
    void renderColumns().then(() => columnsEl.scrollTo({ left: 0 }))
  }

  // Every same-site link click while the prototype is on is the stack's, before the client router
  // sees it.
  function interceptClicks() {
    document.addEventListener(
      "click",
      (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
        const a = (event.target as Element).closest?.("a[href]") as HTMLAnchorElement | null
        if (!a || !root.contains(a) || !isInternal(a)) return
        if (a.closest(".sn-spine")) return
        event.preventDefault()
        event.stopImmediatePropagation()
        const column = a.closest<HTMLElement>(".sn-col")
        if (column) void open(a.href, Number(column.dataset.index))
        else if (a.dataset.snReset !== undefined) reset(a.href)
        else void open(a.href, stack.length - 1)
      },
      { capture: true },
    )
  }

  // ---------------------------------------------------------------------------------------------
  // A small force-laid graph in SVG, for A and B. Positions are kept between redraws, so a node
  // stays where it was as the path grows.

  interface Placed extends SimulationNodeDatum {
    id: string
  }

  const SVG = "http://www.w3.org/2000/svg"
  const svgEl = <K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}) => {
    const element = document.createElementNS(SVG, tag)
    for (const [key, value] of Object.entries(attrs)) element.setAttribute(key, String(value))
    return element
  }

  function forceView(
    host: HTMLElement,
    options: {
      /** Which nodes to draw, besides the path's. */
      around: (path: string[]) => string[]
      labels: "path" | "all"
      radius: { path: number; other: number }
    },
  ) {
    const positions = new Map<string, Placed>()
    const svg = svgEl("svg", { class: "sn-graph" })
    host.append(svg)
    let simulation: ReturnType<typeof forceSimulation<Placed>> | undefined
    let hovered: string | undefined

    function draw() {
      simulation?.stop()
      const path = stack
      const ids = [...new Set([...path, ...options.around(path)])]
      const fresh = ids.filter((id) => !positions.has(id)).length
      const nodes = ids.map((id) => {
        const existing = positions.get(id)
        if (existing) return existing
        // A new node starts beside a neighbour already placed, or near the middle.
        const near = [...(neighbours.get(id) ?? [])].map((n) => positions.get(n)).find(Boolean)
        const placed: Placed = {
          id,
          x: (near?.x ?? 0) + (Math.random() - 0.5) * 30,
          y: (near?.y ?? 0) + (Math.random() - 0.5) * 30,
        }
        positions.set(id, placed)
        return placed
      })
      const idSet = new Set(ids)
      const links: { source: string; target: string; path: boolean }[] = []
      for (const edge of siteGraph.edges) {
        if (edge.kind === "noteNote" && idSet.has(edge.source) && idSet.has(edge.target)) {
          links.push({ source: edge.source, target: edge.target, path: false })
        }
      }
      // The path's own steps pull together, whether or not the graph has an edge for them.
      for (let i = 1; i < path.length; i++) links.push({ source: path[i - 1], target: path[i], path: true })

      simulation = forceSimulation(nodes)
        .force("charge", forceManyBody().strength(-60))
        .force(
          "link",
          forceLink<Placed, (typeof links)[number]>(links.map((link) => ({ ...link })))
            .id((node) => node.id)
            .distance((link) => (link.path ? 50 : 40))
            .strength((link) => (link.path ? 0.6 : 0.15)),
        )
        .force("center", forceCenter(0, 0).strength(0.05))
        .force("collide", forceCollide(10))
        .alpha(fresh === 0 ? 0.3 : 0.8)
        .on("tick", () => paint(nodes, links))
    }

    function paint(nodes: Placed[], links: { source: string; target: string; path: boolean }[]) {
      const path = stack
      const at = (id: string) => positions.get(id)!
      const xs = nodes.map((node) => node.x ?? 0)
      const ys = nodes.map((node) => node.y ?? 0)
      // Fit the nodes, but never zoom in past a 240×180 view.
      const pad = 30
      const [x0, x1, y0, y1] = [Math.min(...xs) - pad, Math.max(...xs) + pad, Math.min(...ys) - pad, Math.max(...ys) + pad]
      const w = Math.max(240, x1 - x0)
      const h = Math.max(180, y1 - y0)
      svg.setAttribute("viewBox", `${(x0 + x1 - w) / 2} ${(y0 + y1 - h) / 2} ${w} ${h}`)
      svg.replaceChildren()

      const edges = svgEl("g", { class: "sn-edges" })
      for (const link of links) {
        if (link.path) continue
        const a = at(link.source)
        const b = at(link.target)
        const lit = hovered !== undefined && (link.source === hovered || link.target === hovered)
        edges.append(svgEl("line", { x1: a.x!, y1: a.y!, x2: b.x!, y2: b.y!, class: lit ? "lit" : "" }))
      }
      svg.append(edges)

      // The path: one line through every step, solid where the graph has the edge, dashed where
      // the step was taken some other way (a tag page's listing, a node clicked on the graph).
      const trail = svgEl("g", { class: "sn-trail" })
      for (let i = 1; i < path.length; i++) {
        const a = at(path[i - 1])
        const b = at(path[i])
        trail.append(
          svgEl("line", {
            x1: a.x!,
            y1: a.y!,
            x2: b.x!,
            y2: b.y!,
            class: linked(path[i - 1], path[i]) ? "" : "jump",
          }),
        )
      }
      svg.append(trail)

      const nodeGroup = svgEl("g", { class: "sn-nodes" })
      for (const node of nodes) {
        const step = path.indexOf(node.id)
        const onPath = step !== -1
        const last = step === path.length - 1
        const nextStep = !onPath && linked(path[path.length - 1], node.id)
        const g = svgEl("g", {
          class: ["node", onPath ? "path" : "", last ? "last" : "", nextStep ? "next" : "", nodeById.get(node.id)?.kind ?? ""].join(" "),
          transform: `translate(${node.x} ${node.y})`,
        })
        g.append(svgEl("circle", { r: onPath ? options.radius.path : options.radius.other }))
        if (onPath) {
          const number = svgEl("text", { class: "step", "text-anchor": "middle", dy: "0.35em" })
          number.textContent = String(step + 1)
          g.append(number)
        }
        if (options.labels === "all" || onPath || hovered === node.id) {
          const label = svgEl("text", { class: "label", "text-anchor": "middle", y: (onPath ? options.radius.path : options.radius.other) + 11 })
          label.textContent = labelOf(node.id)
          g.append(label)
        }
        const title = svgEl("title")
        title.textContent = labelOf(node.id)
        g.append(title)
        g.addEventListener("pointerenter", () => {
          hovered = node.id
          paint(nodes, links)
          highlightColumn(node.id)
        })
        g.addEventListener("pointerleave", () => {
          hovered = undefined
          paint(nodes, links)
          highlightColumn(undefined)
        })
        g.addEventListener("click", () => {
          if (onPath) scrollToColumn(step)
          else void open(node.id, stack.length - 1)
        })
        nodeGroup.append(g)
      }
      svg.append(nodeGroup)
    }

    return { draw }
  }

  function highlightColumn(url: string | undefined) {
    for (const column of columnsEl.querySelectorAll<HTMLElement>(".sn-col")) {
      column.classList.toggle("sn-hover", column.dataset.url === url)
    }
  }

  // ---------------------------------------------------------------------------------------------
  // The top bar every variant has: the site's name, which starts again at the index.

  function topBar(extra = "") {
    const bar = document.createElement("header")
    bar.className = "sn-bar"
    bar.innerHTML = `<a href="/" data-sn-reset class="sn-home">Chaotic Good Computing</a><span class="sn-crumbs"></span>${extra}`
    return bar
  }

  function crumbs(bar: HTMLElement) {
    const holder = bar.querySelector(".sn-crumbs")!
    holder.replaceChildren(
      ...stack.flatMap((url, i) => {
        const crumb = document.createElement("button")
        crumb.textContent = labelOf(url)
        crumb.addEventListener("click", () => scrollToColumn(i))
        return i === 0 ? [crumb] : [Object.assign(document.createElement("span"), { textContent: "→", className: "sep" }), crumb]
      }),
    )
  }

  // ---------------------------------------------------------------------------------------------
  // A: Trail. Columns as Andy has them, and a map of the path in the corner.

  function variantA() {
    root.dataset.variant = "A"
    const bar = topBar()
    columnsEl = Object.assign(document.createElement("div"), { className: "sn-columns" })
    const map = Object.assign(document.createElement("aside"), { className: "sn-trailmap" })
    map.innerHTML = `<h2>Your path</h2>`
    root.replaceChildren(bar, columnsEl, map)
    const view = forceView(map, {
      // The path, and where its last note leads.
      around: (path) => [...(neighbours.get(path[path.length - 1]) ?? [])],
      labels: "path",
      radius: { path: 7, other: 3 },
    })
    onStackChange = () => {
      crumbs(bar)
      view.draw()
    }
  }

  // ---------------------------------------------------------------------------------------------
  // B: Graph rail. Laid out as a page is: a left sidebar, and one note. The whole sidebar is the
  // site's own graph drawing (tag bubbles, hover, drag, zoom) over the local graphs of every note on
  // the path, with the path drawn through it: the notes before this one are its earlier nodes.
  // Clicking one goes back to it and closes what came after.

  let drawn: DrawnGraph | undefined

  /** Every visited note and what is next to it, cut from the whole graph. */
  function pathGraph(path: string[]): Graph {
    const nodes = new Map<string, GraphNode>()
    const edges = new Map<string, GraphEdge>()
    for (const id of path) {
      const local = neighbourhood(siteGraph, id, graphConfig.local.depth)
      for (const node of local.nodes) nodes.set(node.id, node)
      for (const edge of local.edges) edges.set(`${edge.kind} ${edge.source} ${edge.target}`, edge)
    }
    return { nodes: [...nodes.values()], edges: [...edges.values()] }
  }

  function back(i: number) {
    if (i >= stack.length - 1) return
    stack = stack.slice(0, i + 1)
    writeAddress()
    void renderColumns()
  }

  function variantB() {
    root.dataset.variant = "B"
    // The whole sidebar is the graph canvas, with the site's name over its corner.
    const side = Object.assign(document.createElement("aside"), { className: "sn-side" })
    side.innerHTML = `<a href="/" data-sn-reset class="sn-home">Chaotic Good Computing</a>`
    const graphHost = side
    columnsEl = Object.assign(document.createElement("div"), { className: "sn-columns" })
    root.replaceChildren(side, columnsEl)
    const repaint = () => drawn?.repaint()
    document.addEventListener("themechange", repaint)

    onStackChange = () => {
      const last = stack[stack.length - 1]
      drawn?.destroy()
      drawn = drawGraph(graphHost, {
        graph: pathGraph(stack),
        current: last,
        settings: graphConfig.local,
        bubble: (tag) => document.querySelector<HTMLElement>(`#sn-bubbles [data-tag="${CSS.escape(tag)}"] .tag-bubble`),
        follow: (to) => {
          const at = stack.indexOf(to)
          if (at !== -1) back(at)
          else void open(to, stack.length - 1)
        },
        label: `Graph of the notes around your path`,
        path: stack,
      })
    }
  }

  // ---------------------------------------------------------------------------------------------
  // C: Ribbon. The path unrolled over the columns: a station over each, the line between them, and
  // arcs for links between notes on the path the path didn't take. Under each station, the ways out
  // of its note that aren't open.

  function variantC() {
    root.dataset.variant = "C"
    const bar = topBar()
    columnsEl = Object.assign(document.createElement("div"), { className: "sn-columns" })
    const track = Object.assign(document.createElement("div"), { className: "sn-track" })
    root.replaceChildren(bar, columnsEl)
    const ribbon = Object.assign(document.createElement("div"), { className: "sn-ribbon" })

    onStackChange = () => {
      // The ribbon scrolls with the columns: it is the first row inside the scroller.
      columnsEl.prepend(ribbon)
      ribbon.style.gridColumn = `1 / span ${Math.max(1, stack.length)}`
      ribbon.replaceChildren(track)
      const columns = [...columnsEl.querySelectorAll<HTMLElement>(".sn-col")]
      const width = columns[0]?.offsetWidth ?? 600
      const total = columns.length * width
      const height = 92
      const lineY = 54
      const svg = svgEl("svg", { width: total, height, class: "sn-ribbonsvg" })
      const x = (i: number) => i * width + 34

      // Arcs: a link between two notes of the path that aren't next to each other.
      for (let i = 0; i < stack.length; i++) {
        for (let j = i + 2; j < stack.length; j++) {
          if (!linked(stack[i], stack[j])) continue
          const x1 = x(i)
          const x2 = x(j)
          const rise = Math.min(46, 14 + (j - i) * 8)
          svg.append(svgEl("path", { class: "arc", d: `M ${x1} ${lineY} C ${x1} ${lineY - rise}, ${x2} ${lineY - rise}, ${x2} ${lineY}` }))
        }
      }
      // The line.
      for (let i = 1; i < stack.length; i++) {
        svg.append(
          svgEl("line", { x1: x(i - 1), y1: lineY, x2: x(i), y2: lineY, class: linked(stack[i - 1], stack[i]) ? "line" : "line jump" }),
        )
      }
      // Stations, with ticks for the ways out not taken.
      stack.forEach((url, i) => {
        const g = svgEl("g", { class: `station${i === stack.length - 1 ? " last" : ""}`, transform: `translate(${x(i)} ${lineY})` })
        g.append(svgEl("circle", { r: 8 }))
        const number = svgEl("text", { class: "step", "text-anchor": "middle", dy: "0.35em" })
        number.textContent = String(i + 1)
        g.append(number)
        const label = svgEl("text", { class: "label", x: -8, y: -16 })
        label.textContent = labelOf(url)
        g.append(label)
        g.addEventListener("click", () => scrollToColumn(i))
        svg.append(g)

        const outs = [...(neighbours.get(url) ?? [])].filter((n) => !stack.includes(n))
        const ticks = svgEl("g", { class: "ticks", transform: `translate(${x(i)} ${lineY + 16})` })
        outs.slice(0, 24).forEach((out, k) => {
          const tick = svgEl("g", { class: "tick", transform: `translate(${k * 11} 0)` })
          tick.append(svgEl("circle", { r: 3.5 }))
          const title = svgEl("title")
          title.textContent = labelOf(out)
          tick.append(title)
          tick.addEventListener("click", () => void open(out, i))
          ticks.append(tick)
        })
        if (outs.length > 24) {
          const more = svgEl("text", { x: 24 * 11, dy: "0.35em", class: "more" })
          more.textContent = `+${outs.length - 24}`
          ticks.append(more)
        }
        svg.append(ticks)
      })
      track.replaceChildren(svg)
    }
  }

  // ---------------------------------------------------------------------------------------------
  // The switcher: ← variant →, and the arrow keys.

  function switcher() {
    const bar = document.createElement("div")
    bar.className = "sn-switcher"
    const label = document.createElement("span")
    const prev = Object.assign(document.createElement("button"), { textContent: "←", title: "Previous variant" })
    const next = Object.assign(document.createElement("button"), { textContent: "→", title: "Next variant" })
    const off = Object.assign(document.createElement("a"), { textContent: "off", title: "The site as it is", href: encodeURI(stack[0]) })
    off.dataset.astroReload = ""
    bar.append(prev, label, next, off)
    document.body.append(bar)
    const step = (by: number) => {
      const i = VARIANTS.findIndex((each) => each.key === current)
      current = VARIANTS[(i + by + VARIANTS.length) % VARIANTS.length].key
      writeAddress()
      mount()
    }
    prev.addEventListener("click", () => step(-1))
    next.addEventListener("click", () => step(1))
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement
      if (target.closest("input, textarea, [contenteditable], dialog")) return
      if (event.key === "ArrowLeft") step(-1)
      if (event.key === "ArrowRight") step(1)
    })
    return () => {
      const found = VARIANTS.find((each) => each.key === current)!
      label.textContent = `${found.key} (${found.name})`
    }
  }

  // ---------------------------------------------------------------------------------------------

  let label: () => void = () => {}

  function mount() {
    drawn?.destroy()
    drawn = undefined
    ;({ A: variantA, B: variantB, C: variantC })[current]()
    columnsEl.addEventListener("scroll", updateSpines, { passive: true })
    label()
    void renderColumns().then(() => requestAnimationFrame(() => scrollToColumn(stack.length - 1)))
  }

  if (variant) {
    document.documentElement.classList.add("sn-on")
    root.hidden = false
    interceptClicks()
    label = switcher()
    window.addEventListener("resize", () => {
      updateSpines()
      onStackChange()
    })
    void loadGraph().then(() => {
      writeAddress()
      mount()
    })
  }
</script>

