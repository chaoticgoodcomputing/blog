---
// The local graph: the reader's trail (src/lib/trail.ts), each of its notes with what is next to
// it, drawn on a canvas in the graph column with the settings of site configuration's
// `graph.local`, the trail drawn through it, and opened zoomed in on the note shown
// (src/lib/graph-drawing.ts). The trail is in the page's address, so the graph is drawn in the
// browser, from the address and the graph index the site publishes (src/pages/graph.json.ts), as
// each page loads. The canvas holds a list of what it shows, for whoever can't see it.
//
// Every tag's bubble is a `<TagBubble>` here, hidden, which the canvas copies: the bubble is drawn
// one way, with its icon and colour, wherever it is. Any tag may be next to a trail, so all of them
// are here.
//
// While the pointer is off the canvas, only the trail's nodes are drawn in colour; the rest are
// grayscale until the reader points at the graph.
//
// In the corner of its frame is the control that opens the global graph, in a dialog
// (./global-graph/GlobalGraph.astro), which marks the note shown and draws the trail through it
// too. Following a node of either graph is a navigation like any link's, which carries the trail
// on (TrailSpines.astro).
import { graphOf } from "../lib/graph.ts"
import { graphIndex } from "../lib/graph-index.ts"
import { graph } from "../site.config.ts"
import GlobalGraph from "./global-graph/GlobalGraph.astro"
import TagBubble from "./TagBubble.astro"

interface Props {
  /** The page's address, which is its node's id: a note's, the home page's `/`, a tag page's. */
  url: string
}

const { url } = Astro.props
const { removeTags, privatePages } = graph.local
const tags = graphOf(graphIndex(), { removeTags, privatePages }).nodes.flatMap((node) =>
  node.kind === "tag" && node.tag !== undefined ? [node.tag] : [],
)
---

<section class="local-graph" aria-label="Graph View">
  <local-graph>
    <div class="bubbles" hidden>
      {
        tags.map((tag) => (
          <span data-tag={tag}>
            <TagBubble tag={tag} />
          </span>
        ))
      }
    </div>
  </local-graph>
  <GlobalGraph url={url} />
</section>

<script>
  import { navigate } from "astro:transitions/client"
  import { graphOf, trailGraph } from "../lib/graph.ts"
  import { drawGraph, type DrawnGraph } from "../lib/graph-drawing.ts"
  import { loadGraphIndex } from "../lib/graph-index-client.ts"
  import { trailOf } from "../lib/trail.ts"
  import { graph } from "../site.config.ts"

  const settings = graph.local

  class LocalGraph extends HTMLElement {
    #drawn: DrawnGraph | undefined
    #connected = false
    // The canvas is painted in the colours of one colour scheme, so it copies them again when the
    // page's changes.
    #repaint = () => this.#drawn?.repaint()

    connectedCallback() {
      this.#connected = true
      document.addEventListener("themechange", this.#repaint)
    }

    disconnectedCallback() {
      this.#connected = false
      document.removeEventListener("themechange", this.#repaint)
      this.#drawn?.destroy()
      this.#drawn = undefined
    }

    // Drawn as each page loads, when its address, and so its trail, is the page's own.
    async draw() {
      const trail = trailOf(new URL(location.href))
      const shown = trail.at(-1)!
      // The global graph marks the note shown, and draws the trail through itself.
      const opener = this.closest(".local-graph")?.querySelector<HTMLElement>("global-graph")
      if (opener) {
        opener.dataset.url = shown
        opener.dataset.path = JSON.stringify(trail)
      }
      const index = await loadGraphIndex()
      // Taken out of the page while the index was on its way.
      if (!this.#connected) return
      const whole = graphOf(index, { removeTags: settings.removeTags, privatePages: settings.privatePages })
      const here = whole.nodes.find((node) => node.id === shown)
      this.#drawn?.destroy()
      this.#drawn = drawGraph(this, {
        graph: trailGraph(whole, trail, settings.depth),
        current: shown,
        settings,
        bubble: (tag) => this.querySelector<HTMLElement>(`[data-tag="${CSS.escape(tag)}"] .tag-bubble`),
        follow: (to) => void navigate(to),
        label: `Graph of the pages around ${here?.label ?? "this page"}`,
        path: [...trail],
        focus: settings.focusZoom,
        grayOffPath: true,
      })
    }
  }

  customElements.define("local-graph", LocalGraph)
  document.addEventListener("astro:page-load", () => {
    for (const each of document.querySelectorAll<LocalGraph>("local-graph")) void each.draw()
  })
</script>

<style>
  /* The graph fills the room the graph column gives it. The global graph's control sits over its
     top-right corner: where it goes is this frame's to say, so the global graph styles only its
     button. */
  .local-graph {
    position: relative;
    min-height: 0;
    height: 100%;
  }

  .local-graph > :global(.global-graph) {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
  }

  local-graph {
    display: block;
    height: 100%;
    overflow: hidden;
  }

  local-graph :global(canvas) {
    display: block;
  }
</style>
