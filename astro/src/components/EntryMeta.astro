---
// What a note's h-entry says that its page doesn't show (https://microformats.org/wiki/h-entry):
// its address, its author, its summary, when it was last changed, and its tags. The page's `main`
// is the h-entry; its title is the entry's name (ArticleTitle.astro), its date its `dt-published`
// (DateAndReadingTime.astro), its body its content ([...slug].astro), and its Bluesky post its
// `u-syndication` (Discussion.astro). Bridgy reads it to know what a reply on Bluesky answers, as do
// the IndieWeb's readers and a site the note sends a webmention to.
import type { NoteFacts } from "../lib/notes.ts"
import { site } from "../site.config.ts"

interface Props {
  note: NoteFacts
  /** The page's address, from the site's root. */
  url: string
}

const { note, url } = Astro.props
const address = new URL(url, Astro.site).href
---

<div class="entry-meta" hidden data-pagefind-ignore>
  <a class="u-url u-uid" href={address}></a>
  <a class="p-author h-card" href={new URL(site.author.url, Astro.site).href}>{site.author.name}</a>
  {note.summary && <data class="p-summary" value={note.summary}></data>}
  <time class="dt-updated" datetime={note.modified.toISOString()}></time>
  {note.tags.map((tag) => <data class="p-category" value={tag}></data>)}
</div>
