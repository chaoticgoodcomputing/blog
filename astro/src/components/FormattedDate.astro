---
// A date as the site prints one, in a `<time>` that carries the instant itself. Every date a
// reader sees goes through here, so they all read alike.
import { formatDate } from "../lib/dates.ts"
import { site } from "../site.config.ts"

interface Props {
  date: Date
  /** Classes besides its own: a microformat's property, `dt-published`. */
  class?: string
}

const { date, class: className } = Astro.props
---

<time class:list={["formatted-date", className]} datetime={date.toISOString()}>{formatDate(date, site.locale)}</time>
