---
// The colour scheme switch: one control in the left sidebar's toolbar that puts the page in the
// other colour scheme, and keeps the choice for every page after. A switch, named for the dark
// scheme, on when the page is in it, whichever of the reader and their system put it there.
//
// What a choice does is the README's contract ("In the browser"): `data-theme` on `<html>`, the
// choice kept under `SCHEME_KEY`, and `themechange` on `document`, which whatever paints in script
// listens for. A page is put in the kept scheme before it is painted by SchemeBeforePaint.astro.
// Its moon and sun are Material Design Icons, drawn by astro-icon as every icon is (docs/adr/1101).
import { Icon } from "astro-icon/components"
---

<scheme-switch class="scheme-switch">
  <button type="button" role="switch" aria-checked="false" aria-label="Dark colour scheme">
    <Icon name="mdi:weather-night" is:inline class="moon" width="20" height="20" fill="currentColor" aria-hidden="true" />
    <Icon name="mdi:weather-sunny" is:inline class="sun" width="20" height="20" fill="currentColor" aria-hidden="true" />
  </button>
</scheme-switch>

<script>
  import { SCHEME_KEY } from "../lib/colour-scheme.ts"

  type Scheme = "light" | "dark"

  const system = matchMedia("(prefers-color-scheme: dark)")

  /** The scheme the page is in: the reader's choice, else the system's. */
  function shown(): Scheme {
    const chosen = document.documentElement.dataset.theme
    if (chosen === "light" || chosen === "dark") return chosen
    return system.matches ? "dark" : "light"
  }

  function choose(scheme: Scheme) {
    document.documentElement.dataset.theme = scheme
    // Storage can be refused, in a private window or by the reader's settings. The choice then
    // lasts as long as the page does.
    try {
      localStorage.setItem(SCHEME_KEY, scheme)
    } catch {}
    document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: scheme } }))
  }

  class SchemeSwitch extends HTMLElement {
    #button: HTMLButtonElement | null = null
    #toggle = () => choose(shown() === "dark" ? "light" : "dark")
    // The switch says which scheme the page is in after every change, the system's included, which
    // SchemeBeforePaint.astro announces as one.
    #update = () => this.#button?.setAttribute("aria-checked", String(shown() === "dark"))

    connectedCallback() {
      this.#button = this.querySelector("button")
      this.#button?.addEventListener("click", this.#toggle)
      document.addEventListener("themechange", this.#update)
      this.#update()
    }

    disconnectedCallback() {
      this.#button?.removeEventListener("click", this.#toggle)
      document.removeEventListener("themechange", this.#update)
    }
  }

  customElements.define("scheme-switch", SchemeSwitch)
</script>

<style>
  /* Without its script the switch does nothing, so it is not shown; it keeps its room, so the
     toolbar doesn't move when the script arrives. */
  .scheme-switch:not(:defined) {
    visibility: hidden;
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: none;
    color: var(--darkgray);
    cursor: pointer;
  }

  button:hover {
    background: var(--highlight);
  }

  /* The icon is the scheme the switch puts the page in: the moon while it is light. */
  [aria-checked="true"] .moon,
  [aria-checked="false"] .sun {
    display: none;
  }
</style>
