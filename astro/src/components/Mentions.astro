---
// A note's mentions, under its links panel: the pages on other sites that link to it and sent it a
// webmention, newest first (src/lib/mentions.ts). Each by its title, or its site where it has
// none, with who wrote it, when, and what it says of the note. A note with none has no section.
import { newTab } from "../lib/external-links.ts"
import { mentionsOf } from "../lib/mentions.ts"
import { getMentions } from "../lib/note-mentions.ts"
import type { NoteFacts } from "../lib/notes.ts"
import { webmentions } from "../site.config.ts"
import FormattedDate from "./FormattedDate.astro"

interface Props {
  /** The note the page shows, with the address it has. */
  note: (NoteFacts & { url?: string | undefined }) | undefined
}

const { note } = Astro.props
const site = Astro.site!.href
const mentions = note?.url ? mentionsOf(note.url, await getMentions(), webmentions.blockedDomains) : []
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, "")
---

{
  mentions.length > 0 && (
    <section class="mentions">
      <h2>Mentions</h2>
      <ul>
        {mentions.map((mention) => (
          <li>
            <a class="title" href={mention.url} {...newTab(mention.url, site)}>
              {mention.title ?? hostOf(mention.url)}
            </a>
            <p class="meta">
              {[mention.author.name, mention.title ? hostOf(mention.url) : undefined].filter(Boolean).join(", ")}
              {mention.published && (
                <Fragment>
                  {(mention.author.name || mention.title) && " — "}
                  <FormattedDate date={mention.published} />
                </Fragment>
              )}
            </p>
            {mention.excerpt.length > 0 && (
              <blockquote>
                {mention.excerpt.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </blockquote>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 1rem;
  }

  /* Each title is set as the links panel's are, at a heading's weight. */
  .title {
    font-weight: 600;
    text-decoration: none;
  }

  .meta {
    margin: 0;
    color: var(--darkgray);
    font-size: 0.9em;
  }

  blockquote {
    margin: 0.25rem 0 0;
    padding-left: 0.75rem;
    border-left: 2px solid var(--lightgray);
    color: var(--darkgray);
  }

  blockquote p {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }
</style>
