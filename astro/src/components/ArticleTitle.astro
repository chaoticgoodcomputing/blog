---
// The page's title, over its content: the page's one first-level heading, centred. The ways to
// share the page are under the header (ShareLinks.astro).
interface Props {
  title: string
}

const { title } = Astro.props
---

<h1 class="article-title">{title}</h1>

<style>
  h1 {
    margin: 0;
    /* A title with nowhere to break, a tag page's `#a/b/c`, breaks rather than widen the page. */
    overflow-wrap: anywhere;
  }
</style>
