---
// The page's title, over its content: the page's one first-level heading.
interface Props {
  title: string
}

const { title } = Astro.props
---

<h1 class="article-title">{title}</h1>

<style>
  .article-title {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.25;
    /* A title with nowhere to break, a tag page's `#a/b/c`, breaks rather than widen the page. */
    overflow-wrap: anywhere;
  }
</style>
