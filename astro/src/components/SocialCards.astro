---
// The social cards: the site owner's year of contributions on GitHub, then their latest posts on
// Bluesky, with the accounts and wording of site configuration's `social`. The page as built holds
// each card's loading state, and a custom element fills it in the reader's browser, so building the
// site asks neither host for anything. A card that can't be filled says so and links to the
// account's profile, where the reader can see the same.
//
// They are on a desktop only. Hidden anywhere narrower, they ask for nothing there either: each
// element starts when the window is a desktop's, and stops, abandoning its requests, when its page
// is left.
import { site, social } from "../site.config.ts"

const { github, bluesky } = social
const githubProfile = `https://github.com/${encodeURIComponent(github.username)}`
const blueskyProfile = `https://bsky.app/profile/${encodeURIComponent(bluesky.handle)}`
// The calendar's level colours, `--level0` to `--level4`, set once on the cards for every element
// in them to inherit.
const levels = Object.fromEntries(github.levelColors.map((colour, level) => [`--level${level}`, colour]))
---

<div class="social-cards" style={levels}>
  <section class="github-card">
    <h2>{github.title}</h2>
    <github-card data-username={github.username} data-locale={site.locale} data-state="loading">
      <p class="loading" role="status">Loading contributions…</p>
      <p class="failed" hidden>Couldn't load contributions. <a href={githubProfile}>See them on GitHub</a></p>
      <div class="shown" hidden>
        <p class="total"><a href={githubProfile}></a></p>
        <div class="calendar" role="img" aria-label="A square for each day of the last year, coloured by how many contributions it had"></div>
      </div>
    </github-card>
  </section>

  <section class="bluesky-card">
    <h2>{bluesky.title}</h2>
    <bluesky-card
      data-handle={bluesky.handle}
      data-limit={bluesky.postLimit}
      data-metrics={String(bluesky.showMetrics)}
      data-state="loading"
    >
      <p class="loading" role="status">Loading posts…</p>
      <p class="failed" hidden>Couldn't load posts. <a href={blueskyProfile}>See them on Bluesky</a></p>
      <p class="empty" hidden>No posts yet. <a href={blueskyProfile}>See the profile on Bluesky</a></p>
      <div class="shown" hidden></div>
    </bluesky-card>
  </section>
</div>

<script>
  import { getAuthorFeed, renderPost } from "../lib/bluesky"
  import { contributionCalendar, getContributions } from "../lib/github-contributions.ts"

  // A desktop's width, as the site shell's stylesheet writes it (README.md, "Styling").
  const desktop = matchMedia("(width >= 1300px)")

  /**
   * A card filled in the browser. It starts when it is on the page and the window is a desktop's,
   * and when it leaves the page it abandons whatever it asked for. Of its children, the one whose
   * class is its state is shown: `loading`, as built, then `shown`, `failed` or `empty`.
   */
  abstract class SocialCard extends HTMLElement {
    #request: AbortController | undefined
    #start = () => {
      if (!desktop.matches || this.#request) return
      const request = (this.#request = new AbortController())
      this.fill(request.signal).catch(() => request.signal.aborted || this.show("failed"))
    }

    connectedCallback() {
      desktop.addEventListener("change", this.#start)
      this.#start()
    }

    disconnectedCallback() {
      desktop.removeEventListener("change", this.#start)
      this.#request?.abort()
      this.#request = undefined
    }

    protected show(state: "shown" | "failed" | "empty") {
      this.dataset.state = state
      for (const child of this.children) (child as HTMLElement).hidden = !child.classList.contains(state)
    }

    /** Fetches what the card shows and draws it, then shows it. Rejects on a failure. */
    protected abstract fill(signal: AbortSignal): Promise<void>
  }

  class GitHubCard extends SocialCard {
    protected async fill(signal: AbortSignal) {
      const year = await getContributions(this.dataset.username ?? "", { signal })
      const total = this.querySelector(".total a")!
      total.textContent = `${year.total.lastYear.toLocaleString(this.dataset.locale)} contributions in the last year`
      const calendar = this.querySelector<HTMLElement>(".calendar")!
      calendar.replaceChildren(
        ...contributionCalendar(year.contributions).map((day) => {
          const cell = document.createElement("span")
          cell.className = "day"
          cell.dataset.level = String(day.level)
          cell.title = day.label
          cell.style.gridArea = `${day.weekday + 1} / ${day.week + 1}`
          return cell
        }),
      )
      if (signal.aborted) return
      this.show("shown")
      // The newest weeks are on the right, and in view: the rest of the year is scrolled to.
      calendar.scrollLeft = calendar.scrollWidth
    }
  }

  class BlueskyCard extends SocialCard {
    protected async fill(signal: AbortSignal) {
      const showMetrics = this.dataset.metrics === "true"
      const items = await getAuthorFeed(this.dataset.handle ?? "", { limit: Number(this.dataset.limit), signal })
      // Drawn before it is shown, so a post the renderer can't read fails as a failed request does.
      const posts = items.map((item) => renderPost(item, { showMetrics, showContext: true, compact: true })).join("")
      if (signal.aborted) return
      if (items.length === 0) return this.show("empty")
      this.querySelector(".shown")!.innerHTML = posts
      this.show("shown")
    }
  }

  customElements.define("github-card", GitHubCard)
  customElements.define("bluesky-card", BlueskyCard)
</script>

<style>
  .social-cards {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (width >= 1300px) {
    .social-cards {
      display: flex;
    }
  }

  github-card,
  bluesky-card {
    display: block;
  }

  [hidden] {
    display: none;
  }

  .loading,
  .failed,
  .empty {
    margin: 0;
    color: var(--darkgray);
    font-size: 0.875rem;
  }

  .total {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
  }

  .total a {
    color: var(--gray);
  }

  /* GitHub's calendar: a column a week and a row a day, Sunday on top. A year is wider than the
     sidebar, so it scrolls, and opens on the newest weeks. */
  .calendar {
    display: grid;
    grid-template-rows: repeat(7, 10px);
    grid-auto-columns: 10px;
    gap: 2px;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .calendar :global(.day) {
    border-radius: 2px;
    background-color: var(--level0);
  }

  .calendar :global(.day[data-level="1"]) {
    background-color: var(--level1);
  }

  .calendar :global(.day[data-level="2"]) {
    background-color: var(--level2);
  }

  .calendar :global(.day[data-level="3"]) {
    background-color: var(--level3);
  }

  .calendar :global(.day[data-level="4"]) {
    background-color: var(--level4);
  }

  bluesky-card .shown {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  bluesky-card .shown[hidden] {
    display: none;
  }
</style>
