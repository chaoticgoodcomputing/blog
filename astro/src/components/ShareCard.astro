---
// A page's share card in its head: `og:image`, with its size, type and what it shows, and the
// Twitter card, a large image where the page has a card and a summary where it has none. Twitter
// reads the image from `twitter:image`, which it prefers to `og:image`, so both name it. The card is
// drawn when the site builds (src/pages/share-cards, docs/adr/1701).
import type { PageProps } from "../lib/page.ts"
import { SHARE_CARD_SIZE, shareCardUrl } from "../lib/share-card.ts"

type Props = { page: PageProps }

const { page } = Astro.props
const card = shareCardUrl(page)
const image = card === undefined ? undefined : new URL(card, Astro.site).href
---

{
  image === undefined ? (
    <meta name="twitter:card" content="summary" />
  ) : (
    <>
      <meta property="og:image" content={image} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content={String(SHARE_CARD_SIZE.width)} />
      <meta property="og:image:height" content={String(SHARE_CARD_SIZE.height)} />
      <meta property="og:image:alt" content={page.title} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={image} />
      <meta name="twitter:image:alt" content={page.title} />
    </>
  )
}
