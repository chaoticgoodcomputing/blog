---
// The tag explorer: the site's tags as a tree in the left sidebar, each with its tag bubble, its
// name and how many notes are under it, linking to its page, and opening to its subtags and then
// the notes that carry it (src/lib/tag-explorer.ts). The whole tree is drawn when the site builds;
// a script opens and closes its branches, and keeps which the reader opened or closed.
//
// The branches that lead to the page being read start open, and its entries are marked as the
// current page. A branch the reader opened or closed stays so on every page after: the choice is
// kept in local storage, which a client-side navigation and a reload both read, and not by
// `transition:persist` (docs/adr/2101).
//
// Below a tablet's width the tree is a drawer: a popover, opened by a button in the row the left
// sidebar is on a phone. The browser closes it on Escape or a click outside it, and gives the focus
// back to the button; following a link in it brings a page whose drawer is closed, and Tab past its
// end closes it too, so the focus is never on the page behind it.
//
// The tree's levels are drawn by this component again, `Astro.self`, given the branches of one
// level: one feature, one component (README.md, "Working in parallel").
import { Icon } from "astro-icon/components"
import { getNotes } from "../lib/notes.ts"
import { openAt, tagTree, type ExplorerTag } from "../lib/tag-explorer.ts"
import { tagName, tagUrl } from "../lib/tags.ts"
import { site, tagExplorer } from "../site.config.ts"
import TagBubble from "./TagBubble.astro"

interface Props {
  /** The page's address, which marks its entries in the tree. */
  url: string
  /** On a tag page, its tag. */
  tag?: string | undefined
  /** One level of the tree, when this component draws it; with none, the whole explorer. */
  branches?: ExplorerTag[]
  /** The branches that start open. */
  open?: string[]
}

const { url, tag, branches } = Astro.props
const tree = branches ?? tagTree(getNotes(), site.private.explorer)
const open = Astro.props.open ?? openAt(tree, { url, tag })

// A private page's mark, in place of a public page's bullet, as the backlinks panel marks one.
const lock = "mdi:lock"
---

{
  branches === undefined ? (
    <tag-explorer class="tag-explorer">
      <button type="button" class="drawer-button" popovertarget="tag-explorer-drawer" aria-label={tagExplorer.title}>
        <Icon name="mdi:tag-multiple" is:inline width="20" height="20" fill="currentColor" aria-hidden="true" />
      </button>

      <nav id="tag-explorer-drawer" class="drawer" popover aria-labelledby="tag-explorer-title">
        <div class="heading">
          <h2 id="tag-explorer-title">{tagExplorer.title}</h2>
          <button type="button" class="close" popovertarget="tag-explorer-drawer" popovertargetaction="hide" aria-label="Close">
            <Icon name="mdi:close" is:inline width="20" height="20" fill="currentColor" aria-hidden="true" />
          </button>
        </div>
        <ul class="tree">
          <Astro.self url={url} tag={tag} branches={tree} open={open} />
        </ul>
      </nav>
    </tag-explorer>
  ) : (
    branches.map((node) => {
      const isOpen = open.includes(node.tag)
      return (
        <li class="branch" data-tag={node.tag}>
          <div class="row">
            <button type="button" class="fold" aria-label={node.tag} aria-expanded={isOpen ? "true" : "false"} />

            <a class="tag" href={tagUrl(node.tag)} aria-current={node.tag === tag ? "page" : undefined}>
              <TagBubble tag={node.tag} />
              <span class="name">{tagName(node.tag)}</span>
              <span class="count">({node.count})</span>
            </a>
          </div>
          <ul hidden={!isOpen}>
            {node.children.length > 0 && <Astro.self url={url} tag={tag} branches={node.children} open={open} />}
            {node.notes.map((note) => (
              <li>
                <a class="note" href={note.url} aria-current={tag === undefined && note.url === url ? "page" : undefined}>
                  <span class="mark">
                    {note.isPrivate ? (
                      <Icon name={lock} is:inline role="img" aria-label="Private page" width="12" height="12" fill="currentColor" />
                    ) : (
                      <span aria-hidden="true">•</span>
                    )}
                  </span>
                  <span>{note.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      )
    })
  )
}

<script>
  // Which branches the reader opened (true) or closed (false), by tag slug, kept for every page
  // after. A branch they never touched opens as its page says.
  const KEPT = "tag-explorer"

  type Kept = Record<string, boolean>

  // Storage can be refused, in a private window or by the reader's settings. A branch then stays
  // as the reader left it for as long as the page does.
  function kept(): Kept {
    try {
      const value: unknown = JSON.parse(localStorage.getItem(KEPT) ?? "{}")
      return value !== null && typeof value === "object" ? (value as Kept) : {}
    } catch {
      return {}
    }
  }

  function keep(tag: string, open: boolean) {
    try {
      localStorage.setItem(KEPT, JSON.stringify({ ...kept(), [tag]: open }))
    } catch {}
  }

  function setOpen(branch: HTMLElement, open: boolean) {
    branch.querySelector(":scope > .row > .fold")?.setAttribute("aria-expanded", String(open))
    branch.querySelector(":scope > ul")?.toggleAttribute("hidden", !open)
  }

  // From a tablet's width up the tree is in the sidebar, and the drawer is no more.
  const wide = matchMedia("(width >= 1000px)")

  class TagExplorer extends HTMLElement {
    #drawer!: HTMLElement

    #onClick = (event: MouseEvent) => {
      const target = event.target as Element
      const fold = target.closest(".fold")
      const branch = fold?.closest<HTMLElement>(".branch")
      if (fold && branch?.dataset.tag) {
        const open = fold.getAttribute("aria-expanded") !== "true"
        setOpen(branch, open)
        keep(branch.dataset.tag, open)
      } else if (target.closest("a")) {
        // Under client-side navigation the page stays a moment while the next one is fetched.
        this.#close()
      }
    }

    // The drawer takes the focus as it opens, and shows where the page being read is in it.
    #onToggle = (event: Event) => {
      if ((event as ToggleEvent).newState !== "open") return
      this.querySelector<HTMLElement>(".close")?.focus()
      this.#showCurrent()
    }

    #close = () => {
      if (this.#drawer.matches(":popover-open")) this.#drawer.hidePopover()
    }

    // The focus has gone from the drawer to the page behind it. Gone nowhere, it has left the
    // window, and the drawer stays for when it is back.
    #onFocusOut = (event: FocusEvent) => {
      const to = event.relatedTarget as Node | null
      if (to && !this.#drawer.contains(to)) this.#close()
    }

    #showCurrent() {
      this.querySelector('.tree [aria-current="page"]')?.scrollIntoView({ block: "nearest" })
    }

    connectedCallback() {
      this.#drawer = this.querySelector(".drawer")!
      const choices = kept()
      for (const branch of this.querySelectorAll<HTMLElement>(".branch")) {
        const open = choices[branch.dataset.tag ?? ""]
        if (typeof open === "boolean") setOpen(branch, open)
      }
      this.addEventListener("click", this.#onClick)
      this.#drawer.addEventListener("toggle", this.#onToggle)
      this.#drawer.addEventListener("focusout", this.#onFocusOut)
      wide.addEventListener("change", this.#close)
      this.#showCurrent()
    }

    disconnectedCallback() {
      this.removeEventListener("click", this.#onClick)
      this.#drawer.removeEventListener("toggle", this.#onToggle)
      this.#drawer.removeEventListener("focusout", this.#onFocusOut)
      wide.removeEventListener("change", this.#close)
    }
  }

  customElements.define("tag-explorer", TagExplorer)
</script>

<style>
  .tag-explorer {
    display: block;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each level under a tag is indented to its name. */
  .branch > ul {
    margin-left: 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--lightgray);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 5px;
    background: none;
    color: var(--darkgray);
    cursor: pointer;
  }

  button:hover {
    background: var(--highlight);
  }

  .fold {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* A fold's chevron is two sides of a square, drawn here rather than as an icon, since every tag
     on every page has one. It points right, and down while its branch is open. */
  .fold::before {
    content: "";
    width: 0.35rem;
    height: 0.35rem;
    margin-left: -0.15rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .fold[aria-expanded="true"]::before {
    margin: -0.15rem 0 0;
    transform: rotate(45deg);
  }

  a {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.25rem;
    border-radius: 5px;
    color: var(--darkgray);
    text-decoration: none;
  }

  a:hover {
    background: var(--highlight);
    color: var(--secondary);
  }

  /* The page being read, wherever it is in the tree. */
  a[aria-current="page"] {
    background: var(--highlight);
    color: var(--secondary);
    font-weight: 600;
  }

  /* A tag bubble, a size smaller among the tree's lines than among text. */
  .tag :global(.tag-bubble) {
    --bubble-size: 1.5rem;
  }

  .name {
    overflow-wrap: anywhere;
  }

  .count {
    font-size: 0.85em;
  }

  /* A note's title, after a box the height of its first line that holds its bullet or lock, so a
     title that wraps keeps its mark beside its first line. */
  .note {
    align-items: flex-start;
    font-size: 0.9rem;
  }

  .mark {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1.5em;
    color: var(--gray);
  }

  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .close,
  .drawer-button {
    width: 2rem;
    height: 2rem;
  }

  /* A phone: the tree is a drawer from the window's left edge, over the page, which holds still
     behind it. */
  @media (width < 1000px) {
    .drawer {
      box-sizing: border-box;
      width: min(20rem, 100% - 3rem);
      height: 100%;
      max-height: none;
      margin: 0 auto 0 0;
      padding: 1.5rem 1rem 2rem;
      border: none;
      border-right: 1px solid var(--lightgray);
      background: var(--light);
      color: var(--darkgray);
      overflow-y: auto;
    }

    .drawer::backdrop {
      background: var(--scrim);
      backdrop-filter: blur(2px);
    }

    :global(html:has(.tag-explorer .drawer:popover-open)) {
      overflow: hidden;
    }
  }

  /* A tablet and a desktop: the tree is in the sidebar, where the drawer was, and there is no
     drawer to open or close. */
  @media (width >= 1000px) {
    .drawer-button,
    .close {
      display: none;
    }

    .drawer {
      display: block;
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      border: none;
      background: none;
      color: inherit;
      overflow: visible;
    }
  }
</style>
