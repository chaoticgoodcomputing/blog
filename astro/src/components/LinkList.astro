---
// One column of the links panel (./PageLinks.astro), under its heading: pages, each by its title,
// with its date and its description under it, where it has them, as the post listing sets them. A
// private page is listed with a lock, where `site.private.backlinks` lists one at all
// (src/lib/backlinks.ts).
import { Icon } from "astro-icon/components"
import type { Backlink } from "../lib/backlinks.ts"
import FormattedDate from "./FormattedDate.astro"

interface Props {
  heading: string
  links: Backlink[]
  class: string
}

const { heading, links, class: name } = Astro.props

// A private page's mark, in place of a public page's bullet: the icon `mdi:lock`, drawn inline by
// astro-icon when the site builds, as a tag bubble's icon is (docs/adr/1101), in the link's colour.
const lock = "mdi:lock"
---

{
  links.length > 0 && (
    <section class={name}>
      <h2>{heading}</h2>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url}>
              <span class="mark">
                {link.isPrivate ? (
                  <Icon name={lock} is:inline role="img" aria-label="Private page" width="12" height="12" fill="currentColor" />
                ) : (
                  <span aria-hidden="true">•</span>
                )}
              </span>
              <span>{link.title}</span>
            </a>
            {(link.date || link.description) && (
              <p class="meta">
                {link.date && <FormattedDate date={link.date} />}
                {link.description && <span class="description">{`${link.date ? " — " : ""}${link.description}`}</span>}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    margin-top: 0.5rem;
  }

  /* Each is set as the headings are, at a heading's weight in their face, as on the Quartz site. */
  a {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* Before each title, a box the height of its first line, which holds the bullet or the lock, so
     that a title that wraps keeps its mark beside its first line. */
  .mark {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1.5em;
  }

  .mark > span {
    color: var(--gray);
  }

  /* Under the title, in line with it past the mark: the mark's box and the gap after it. */
  .meta {
    margin: 0;
    padding-left: 1.5rem;
    color: var(--darkgray);
    font-size: 0.9em;
  }
</style>
