---
// A source's mentions of a note as comments, in its discussion panel (Connections.astro):
// Bluesky's replies and Hacker News's comments, each by who wrote it and when, the date the link to
// it, over what it says, as text. The panel's heading says where they are. They are shown a page at
// a time (PagedList.astro).
import { newTab } from "../lib/external-links.ts"
import type { Mention } from "../lib/mentions.ts"
import FormattedDate from "./FormattedDate.astro"
import PagedList from "./PagedList.astro"

interface Props {
  mentions: Mention[]
  /** How many it shows at first, and how many more at each asking (PagedList.astro). */
  show?: number | undefined
  more?: number | undefined
}

const { mentions, show, more } = Astro.props
const site = Astro.site!.href
---

<PagedList show={show} more={more}>
  <ul class="mentions">
    {mentions.map((mention) => (
      <li>
        <p class="byline">
          {mention.author.name &&
            (mention.author.url ? (
              <a class="author" href={mention.author.url} {...newTab(mention.author.url, site)}>
                {mention.author.name}
              </a>
            ) : (
              <span class="author">{mention.author.name}</span>
            ))}
          {mention.author.name && " · "}
          <a class="when" href={mention.url} {...newTab(mention.url, site)}>
            {mention.published ? <FormattedDate date={mention.published} /> : "Reply"}
          </a>
        </p>
        {mention.excerpt.map((paragraph) => (
          <p class="excerpt">{paragraph}</p>
        ))}
      </li>
    ))}
  </ul>
</PagedList>

<style>
  .mentions {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mentions li {
    padding-left: 0.75rem;
    border-left: 2px solid var(--lightgray);
  }

  .mentions li + li {
    margin-top: 1rem;
  }

  /* In the reading scale's small step (global.css), wherever the list is put. */
  .mentions {
    font-size: var(--text-small);
  }

  .byline {
    margin: 0;
    color: var(--darkgray);
    font-size: 0.9em;
  }

  /* Who wrote it, at a heading's weight, as the incoming and outgoing links' titles are. */
  .author,
  .byline a {
    font-weight: 600;
    text-decoration: none;
  }

  /* The date, as the link to the mention: as quiet as a date, until the pointer is on it. */
  .byline a.when {
    font-weight: normal;
    color: inherit;
  }

  .byline a.when:hover,
  .byline a.when:focus-visible {
    text-decoration: underline;
  }

  .excerpt {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }
</style>
