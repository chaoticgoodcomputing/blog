---
// What is related to a note, under its body, in one carousel (Carousel.astro), a panel at a time:
//
//   1. Outgoing Links: the pages it links to, its outlinks;
//   2. Incoming Links: the pages that link to it, its backlinks, an embed counting as a link
//      (src/lib/backlinks.ts);
//   3. its discussion, a panel for each source of it that is on (src/lib/discussion.ts): Around the
//      Web, the other sites that mention it, then Bluesky's and Hacker News's, each with a `+`
//      beside its heading that takes the reader to where they answer there.
//
// The links and the other sites are listed as the post listings list posts (PostList.astro), the
// other sites with no tags; Bluesky's and Hacker News's as comments (MentionList.astro).
//
// A links panel with nothing in it is left out; a discussion panel with nothing in it says there is
// no discussion yet, with a link to where the reader could be the first to answer. A note with no
// panel has no carousel. A private page has no discussion: what it publishes is a stub.
// The site's Bluesky post of the note is its copy there, which its h-entry names (`u-syndication`).
import { backlinksOf, outlinksOf } from "../lib/backlinks.ts"
import type { DiscussionPanel } from "../lib/discussion.ts"
import { newTab } from "../lib/external-links.ts"
import type { Mention } from "../lib/mentions.ts"
import { getDiscussionPanels } from "../lib/note-discussion.ts"
import type { NoteFacts } from "../lib/notes.ts"
import Carousel, { type Slide } from "./Carousel.astro"
import MentionList from "./MentionList.astro"
import PostList from "./PostList.astro"

interface Props {
  /** The note the page shows, with the address it has. A page that shows none has nothing related. */
  note: (NoteFacts & { url?: string | undefined }) | undefined
  /** Whether the page shows the note's discussion: a note's and an annotation's do, a tag's doesn't. */
  discussion: boolean
}

const { note, discussion } = Astro.props
const site = Astro.site!.href
const back = note ? backlinksOf(note) : []
const out = note ? outlinksOf(note) : []
const panels: DiscussionPanel[] =
  discussion && note?.url !== undefined && !note.isPrivate ? await getDiscussionPanels(note.url, note.title, site) : []

// Another site's page, as a post: its title, or its site's name with none; who wrote it and where,
// `<author> at <site>`, or the site alone with no author; and what it says of the note.
const asPage = (mention: Mention) => {
  const host = new URL(mention.url).host.replace(/^www\./, "")
  return {
    url: mention.url,
    title: mention.title ?? host,
    byline: mention.author.name ? `${mention.author.name} at ${host}` : host,
    date: mention.published,
    description: mention.excerpt.join(" "),
  }
}

const slides: Slide[] = [
  ...(out.length > 0 ? [{ key: "outlinks", title: "Outgoing Links", class: "outlinks" }] : []),
  ...(back.length > 0 ? [{ key: "backlinks", title: "Incoming Links", class: "backlinks" }] : []),
  ...panels.map((panel) => ({
    key: panel.source,
    title: panel.title,
    class: "discussion",
    attributes: { "data-source": panel.source },
    action: {
      href: panel.action.href,
      label: panel.action.label,
      icon: "mdi:plus",
      class: panel.action.syndication ? "u-syndication" : undefined,
    },
  })),
]
---

{
  slides.length > 0 && (
    <Carousel class="related-content" slideClass="related" noun="panel" id="related" slides={slides}>
      <PostList slot="outlinks" pages={out} noun={["link", "links"]} />
      <PostList slot="backlinks" pages={back} noun={["link", "links"]} />
      {panels.map((panel) => (
        <Fragment slot={panel.source}>
          {panel.detail && (
            <p class="detail">
              <a href={panel.action.href} {...newTab(panel.action.href, site)}>
                {panel.detail}
              </a>
            </p>
          )}
          {panel.mentions.length === 0 ? (
            <p class="empty">
              No discussion yet.{" "}
              <a href={panel.action.href} {...newTab(panel.action.href, site)}>
                Be the first to reply
              </a>
              .
            </p>
          ) : panel.source === "webmentions" ? (
            <PostList pages={panel.mentions.map(asPage)} noun={["mention", "mentions"]} />
          ) : (
            <MentionList mentions={panel.mentions} />
          )}
        </Fragment>
      ))}
    </Carousel>
  )
}

<style>
  .detail,
  .empty {
    margin: 0;
    color: var(--darkgray);
    text-align: center;
  }

  .detail a {
    color: inherit;
  }
</style>
