---
// Every published note but the index note, each at its own address.
import type { GetStaticPaths } from "astro"
import { render } from "astro:content"
import Prose from "../components/Prose.astro"
import Page from "../layouts/Page.astro"
import { getNoteEntries } from "../lib/entries.ts"
import { getNote, getNoteIndex } from "../lib/notes.ts"
import { sitePageAt } from "../lib/site-pages.ts"

import AnnotationViewer from "../components/annotation-viewer/AnnotationViewer.astro"
import { mirrorFor, mirrorTextFor } from "../lib/mirrors.ts"

export const getStaticPaths = (async () =>
  (await getNoteEntries())
    // The index note is the home page, a route of its own (index.astro).
    .filter(({ note }) => note.url !== "/")
    .map(({ note, entry }) => ({ params: { slug: note.url.slice(1) }, props: { entry } }))) satisfies GetStaticPaths

const { entry } = Astro.props
// Asked for again here, not carried from the paths, so the dev server shows the note as the vault
// was last read.
const note = getNote(entry.id)!
const { Content, headings } = await render(entry)

// How the site describes the page (src/lib/site-pages.ts). A note with an annotation target is an
// annotation page: its body is its preface, its annotations and its epilogue (src/lib/annotations.ts).
const page = sitePageAt(getNoteIndex(), note.url)!
// The body is the note's h-entry's content (EntryMeta.astro).
// An annotation page whose document the site mirrors has the document drawn beside its body.
const mirror = page.kind === "annotation" ? mirrorFor(note) : undefined
// And a scanned one's text, which its pages don't have (src/lib/mirrors.ts).
const mirrorText = mirror ? mirrorTextFor(note) : undefined
---

<Page {...page} headings={headings}>
  {
    mirror ? (
      <AnnotationViewer note={note} mirror={mirror} text={mirrorText}>
        <Prose class="e-content">
          <Content />
        </Prose>
      </AnnotationViewer>
    ) : (
      <Prose class="e-content">
        <Content />
      </Prose>
    )
  }
</Page>
