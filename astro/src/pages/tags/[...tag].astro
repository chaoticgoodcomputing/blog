---
// Every tag's page, at `tags/<tag slug>`: one for each tag a published note carries and each
// ancestor of one (src/lib/tag-pages.ts). Its body is the tags it links to and the tag's
// description note, where the vault has one; the site shell lists the posts under the tag after it.
import type { GetStaticPaths } from "astro"
import { render } from "astro:content"
import Prose from "../../components/Prose.astro"
import TagPageTags from "../../components/TagPageTags.astro"
import Page from "../../layouts/Page.astro"
import { entryOf } from "../../lib/entries.ts"
import { sitePageAt, sitePages } from "../../lib/site-pages.ts"
import { tagUrl } from "../../lib/tags.ts"
import { getNoteIndex } from "../../lib/notes.ts"

export const getStaticPaths = (() =>
  sitePages(getNoteIndex()).flatMap(({ kind, tag }) => (kind === "tag" && tag !== undefined ? [{ params: { tag }, props: { tag } }] : []))) satisfies GetStaticPaths

const { tag } = Astro.props
// Asked for here, not carried from the paths, so the dev server shows the note as the vault was
// last read.
// What its head and its share card say (src/lib/site-pages.ts).
const page = sitePageAt(getNoteIndex(), tagUrl(tag))!
const description = page.note ? await render(await entryOf(page.note)) : undefined
const Content = description?.Content
---

<Page {...page} headings={description?.headings}>
  <TagPageTags tag={tag} />
  {
    Content && (
      <Prose>
        <Content />
      </Prose>
    )
  }
</Page>
