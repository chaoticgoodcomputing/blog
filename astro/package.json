{
  "name": "@chaoticgoodcomputing/astro-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prototype: the vault rendered by Astro, through @chaoticgoodcomputing/obsidian-markdown.",
  "scripts": {
    "vault": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/assemble-vault.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "e2e": "playwright test",
    "mirrors": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/pin-mirrors.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@chaoticgoodcomputing/obsidian-markdown": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/mdi": "1.2.3",
    "approx-string-match": "^2.0.0",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.0",
    "mermaid": "^12.0.0",
    "pagefind": "^1.5.2",
    "pdfjs-dist": "5.4.530",
    "preact": "^10.29.8",
    "reading-time": "^1.5.0",
    "satori": "^0.33.5",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.15.0",
    "node-html-parser": "^6.1.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "xmllint-wasm": "^5.3.0"
  }
